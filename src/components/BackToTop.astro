---
// Bouton retour en haut — apparaît après 400px de scroll
---

<button
  id="back-to-top"
  aria-label="Retour en haut de la page"
  class="fixed bottom-20 right-6 z-[80] hidden h-11 w-11 items-center justify-center rounded-full bg-white border border-slate-200 shadow-md text-slate-500 transition hover:bg-brand-50 hover:text-brand-600 hover:border-brand-200 md:bottom-6"
>
  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script is:inline>
(function () {
  const btn = document.getElementById("back-to-top");
  if (!btn) return;

  window.addEventListener("scroll", function () {
    if (window.scrollY > 400) {
      btn.classList.remove("hidden");
      btn.classList.add("flex");
    } else {
      btn.classList.add("hidden");
      btn.classList.remove("flex");
    }
  }, { passive: true });

  btn.addEventListener("click", function () {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
})();
</script>
