---
const engagements = [
  {
    icon: "🚚",
    titre: "Livraison sous 48h",
    texte: "Véhicule chargé et prêt à rouler, livré à votre adresse à Paris et en petite couronne.",
  },
  {
    icon: "📞",
    titre: "Assistance 7j/7",
    texte: "Ligne dédiée pendant vos heures de location. Intervention sous 4h en Île-de-France.",
  },
  {
    icon: "🔧",
    titre: "Maintenance incluse",
    texte: "Révisions et pièces d'usure prises en charge en longue durée et contrats entreprise.",
  },
  {
    icon: "📋",
    titre: "Tarifs transparents",
    texte: "Prix TTC affichés, caution restituée sous 5 jours, aucun frais caché.",
  },
  {
    icon: "🔄",
    titre: "Vélo de remplacement",
    texte: "Si immobilisation prolongée, remplacement livré sous 24 à 48 h.",
  },
  {
    icon: "⚡",
    titre: "Réponse sous 2h",
    texte: "Toute demande de réservation ou devis reçoit une réponse en moins de 2 h ouvrées.",
  },
];
---

<section class="bg-white py-16">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-widest text-brand-600">Nos engagements</p>
      <h2 class="mt-1 font-display text-2xl font-bold text-ink-900 md:text-3xl">
        Une location simple et transparente
      </h2>
      <p class="mt-3 text-sm text-slate-600 leading-relaxed">
        LocPro Mobilité accompagne particuliers et entreprises à Paris et en Île-de-France.
        Pas de promesses creuses — des services concrets, contractuels et vérifiables.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {engagements.map((e) => (
        <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <span class="text-2xl" aria-hidden="true">{e.icon}</span>
          <h3 class="mt-3 font-semibold text-ink-900">{e.titre}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{e.texte}</p>
        </article>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-slate-500">
      <a href="/nos-engagements" class="font-semibold text-brand-700 hover:underline">
        Voir tous nos engagements →
      </a>
      {" · "}
      <a href="/reserver" class="font-semibold text-brand-700 hover:underline">
        Réserver un véhicule →
      </a>
    </p>
  </div>
</section>
