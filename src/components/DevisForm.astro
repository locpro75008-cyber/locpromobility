---
import { SITE_CONTACT, SITE_DELAYS } from "../lib/site";

interface Props {
  id?: string;
  action?: string;
  formName?: string;
}

const {
  id = "devis",
  action = import.meta.env.PUBLIC_DEVIS_FORM_ACTION || import.meta.env.PUBLIC_CONTACT_FORM_ACTION || "",
  formName = "devis-b2b",
} = Astro.props;
const cls =
  "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none";
---

<style>
  .flatpickr-months .flatpickr-month,
  .flatpickr-weekdays,
  span.flatpickr-weekday {
    background: #15803d !important;
    color: #fff !important;
    fill: #fff !important;
  }
  .flatpickr-current-month .flatpickr-monthDropdown-months,
  .flatpickr-current-month input.cur-year {
    color: #fff !important;
  }
  .flatpickr-day.selected,
  .flatpickr-day.selected:hover {
    background: #15803d !important;
    border-color: #15803d !important;
  }
  .flatpickr-day:hover { background: #dcfce7 !important; }
  .flatpickr-day.inRange {
    background: #bbf7d0 !important;
    border-color: #bbf7d0 !important;
    box-shadow: -5px 0 0 #bbf7d0, 5px 0 0 #bbf7d0;
  }
  .devis-addr-list li {
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: #1e293b;
    border-bottom: 1px solid #f1f5f9;
  }
  .devis-addr-list li:last-child { border-bottom: none; }
  .devis-addr-list li:hover, .devis-addr-list li.active {
    background: #f0fdf4;
    color: #15803d;
  }
</style>

<form
  id={id}
  class="space-y-4"
  method="POST"
  action={action || undefined}
  name={formName}
  data-netlify={import.meta.env.PUBLIC_NETLIFY === "true" ? "true" : undefined}
  data-netlify-honeypot="bot-field-devis"
  novalidate
>
  {
    import.meta.env.PUBLIC_NETLIFY === "true" && (
      <input type="hidden" name="form-name" value={formName} />
    )
  }
  <p class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
    <label>
      Ne pas remplir
      <input type="text" name="bot-field-devis" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for={`${id}-societe`} class="mb-1 block text-sm font-medium text-slate-700"
        >Société <span class="text-red-600">*</span></label
      >
      <input
        id={`${id}-societe`}
        name="societe"
        type="text"
        required
        autocomplete="organization"
        class="w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
      />
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-societe`}></p>
    </div>
    <div>
      <label for={`${id}-siret`} class="mb-1 block text-sm font-medium text-slate-700"
        >SIRET <span class="text-red-600">*</span></label
      >
      <input
        id={`${id}-siret`}
        name="siret"
        type="text"
        required
        inputmode="numeric"
        autocomplete="off"
        class="w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
      />
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-siret`}></p>
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for={`${id}-nom`} class="mb-1 block text-sm font-medium text-slate-700"
        >Nom du contact <span class="text-red-600">*</span></label
      >
      <input
        id={`${id}-nom`}
        name="nom_contact"
        type="text"
        required
        class="w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
      />
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-nom`}></p>
    </div>
    <div>
      <label for={`${id}-email`} class="mb-1 block text-sm font-medium text-slate-700"
        >E-mail pro <span class="text-red-600">*</span></label
      >
      <input
        id={`${id}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        class="w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
      />
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-email`}></p>
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-3">
    <div>
      <label for={`${id}-nb`} class="mb-1 block text-sm font-medium text-slate-700"
        >Nb. véhicules <span class="text-red-600">*</span></label
      >
      <input
        id={`${id}-nb`}
        name="nombre_vehicules"
        type="number"
        min="1"
        required
        class="w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
      />
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-nb`}></p>
    </div>
    <div>
      <label for={`${id}-duree`} class="mb-1 block text-sm font-medium text-slate-700"
        >Durée <span class="text-red-600">*</span></label
      >
      <select
        id={`${id}-duree`}
        name="duree"
        required
        class="w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
      >
        <option value="">Choisir…</option>
        <option value="court">Court (&lt; 1 semaine)</option>
        <option value="moyen">Moyen (1 sem. – 3 mois)</option>
        <option value="long">Long (&gt; 3 mois)</option>
      </select>
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-duree`}></p>
    </div>
    <div>
      <label for={`${id}-tel`} class="mb-1 block text-sm font-medium text-slate-700"
        >Téléphone</label
      >
      <input
        id={`${id}-tel`}
        name="telephone"
        type="tel"
        class="w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
      />
    </div>
  </div>
  <!-- Dates -->
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for={`${id}-debut`} class="mb-1 flex items-center gap-1 text-sm font-medium text-slate-700">
        <svg class="h-4 w-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Date de départ souhaitée <span class="text-red-600">*</span>
      </label>
      <div class="relative">
        <input
          id={`${id}-debut`}
          name="date_debut"
          type="text"
          readonly
          placeholder="Cliquez pour choisir…"
          required
          class={`${cls} cursor-pointer pr-10`}
        />
        <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </span>
      </div>
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-debut`}></p>
    </div>
    <div>
      <label for={`${id}-fin`} class="mb-1 flex items-center gap-1 text-sm font-medium text-slate-700">
        <svg class="h-4 w-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Date de retour souhaitée <span class="text-red-600">*</span>
      </label>
      <div class="relative">
        <input
          id={`${id}-fin`}
          name="date_fin"
          type="text"
          readonly
          placeholder="Cliquez pour choisir…"
          required
          class={`${cls} cursor-pointer pr-10`}
        />
        <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </span>
      </div>
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-fin`}></p>
    </div>
  </div>

  <!-- Adresses -->
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="relative">
      <label for={`${id}-livraison`} class="mb-1 flex items-center gap-1 text-sm font-medium text-slate-700">
        <svg class="h-4 w-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Adresse de livraison <span class="text-red-600">*</span>
      </label>
      <input
        id={`${id}-livraison`}
        name="adresse_livraison"
        type="text"
        autocomplete="off"
        placeholder="Ex : 10 rue de Rivoli, Paris"
        required
        class={cls}
      />
      <ul
        id={`${id}-livraison-list`}
        class="devis-addr-list absolute z-50 mt-1 hidden w-full overflow-hidden rounded-lg border border-slate-200 bg-white shadow-lg"
        role="listbox"
      ></ul>
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-livraison`}></p>
    </div>
    <div class="relative">
      <label for={`${id}-recup`} class="mb-1 flex items-center gap-1 text-sm font-medium text-slate-700">
        <svg class="h-4 w-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Adresse de récupération <span class="text-red-600">*</span>
      </label>
      <input
        id={`${id}-recup`}
        name="adresse_recuperation"
        type="text"
        autocomplete="off"
        placeholder="Ex : 60 rue François Ier, Paris"
        required
        class={cls}
      />
      <ul
        id={`${id}-recup-list`}
        class="devis-addr-list absolute z-50 mt-1 hidden w-full overflow-hidden rounded-lg border border-slate-200 bg-white shadow-lg"
        role="listbox"
      ></ul>
      <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-recup`}></p>
    </div>
  </div>

  <div>
    <label for={`${id}-usage`} class="mb-1 block text-sm font-medium text-slate-700"
      >Usage prévu <span class="text-red-600">*</span></label
    >
    <textarea
      id={`${id}-usage`}
      name="usage"
      required
      rows="3"
      class="w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
    ></textarea>
    <p class="mt-1 hidden text-xs text-red-600" data-devis-error={`${id}-usage`}></p>
  </div>

  <button
    type="submit"
    class="rounded-lg bg-brand-700 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-800"
  >
    Demander un devis
  </button>
  <p
    id={`${id}-success`}
    class="hidden rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-900"
    role="status"
  >
    Demande enregistrée. Notre équipe commerciale vous contacte sous {SITE_DELAYS.devisResponse}.
  </p>
</form>

<script define:vars={{ formId: id, formAction: action, phoneDisplay: SITE_CONTACT.phoneDisplay }}>
  async function initDevisExtras() {
    if (!document.querySelector("link[data-flatpickr]")) {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css";
      link.dataset.flatpickr = "1";
      document.head.appendChild(link);
    }
    if (typeof window.flatpickr === "undefined") {
      await new Promise((res, rej) => {
        const s = document.createElement("script");
        s.src = "https://cdn.jsdelivr.net/npm/flatpickr";
        s.onload = res; s.onerror = rej;
        document.head.appendChild(s);
      });
    }
    if (!window.flatpickr?.l10ns?.fr) {
      await new Promise((res, rej) => {
        const s = document.createElement("script");
        s.src = "https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js";
        s.onload = res; s.onerror = rej;
        document.head.appendChild(s);
      });
    }

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let fpFin;
    const fpDebut = window.flatpickr(`#${formId}-debut`, {
      locale: "fr", dateFormat: "d/m/Y", minDate: today, disableMobile: true,
      onChange(dates) {
        if (dates.length && fpFin) {
          fpFin.set("minDate", dates[0]);
          if (fpFin.selectedDates[0] && fpFin.selectedDates[0] < dates[0]) fpFin.clear();
        }
      },
    });
    fpFin = window.flatpickr(`#${formId}-fin`, {
      locale: "fr", dateFormat: "d/m/Y", minDate: today, disableMobile: true,
    });

    function setupAddr(inputId, listId) {
      const input = document.getElementById(inputId);
      const list = document.getElementById(listId);
      if (!input || !list) return;
      let timer;
      input.addEventListener("input", function () {
        clearTimeout(timer);
        const q = this.value.trim();
        if (q.length < 3) { list.classList.add("hidden"); list.innerHTML = ""; return; }
        timer = setTimeout(async () => {
          try {
            const res = await fetch(`https://api-adresse.data.gouv.fr/search/?q=${encodeURIComponent(q)}&limit=5&autocomplete=1`);
            const data = await res.json();
            const features = data.features || [];
            if (!features.length) { list.classList.add("hidden"); return; }
            list.innerHTML = features.map(f =>
              `<li data-value="${f.properties.label}" role="option" tabindex="-1">
                <span class="font-medium">${f.properties.name}</span>
                <span class="ml-1 text-xs text-slate-400">${f.properties.postcode} ${f.properties.city}</span>
              </li>`
            ).join("");
            list.classList.remove("hidden");
            list.querySelectorAll("li").forEach(item => {
              item.addEventListener("mousedown", e => {
                e.preventDefault();
                input.value = item.dataset.value;
                list.classList.add("hidden"); list.innerHTML = "";
              });
            });
          } catch { list.classList.add("hidden"); }
        }, 280);
      });
      input.addEventListener("blur", () => setTimeout(() => list.classList.add("hidden"), 200));
      input.addEventListener("keydown", e => {
        const items = list.querySelectorAll("li");
        const active = list.querySelector("li.active");
        const idx = Array.from(items).indexOf(active);
        if (e.key === "ArrowDown") { e.preventDefault(); if (active) active.classList.remove("active"); (items[idx + 1] || items[0])?.classList.add("active"); }
        else if (e.key === "ArrowUp") { e.preventDefault(); if (active) active.classList.remove("active"); (items[idx - 1] || items[items.length - 1])?.classList.add("active"); }
        else if (e.key === "Enter" && active) { e.preventDefault(); input.value = active.dataset.value; list.classList.add("hidden"); }
        else if (e.key === "Escape") list.classList.add("hidden");
      });
    }
    setupAddr(`${formId}-livraison`, `${formId}-livraison-list`);
    setupAddr(`${formId}-recup`, `${formId}-recup-list`);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDevisExtras);
  } else {
    initDevisExtras();
  }

  const form = document.getElementById(formId);
  if (form instanceof HTMLFormElement) {
    const showErr = (fieldId, msg) => {
      const el = form.querySelector(`[data-devis-error="${fieldId}"]`);
      if (el instanceof HTMLElement) {
        el.textContent = msg;
        el.classList.remove("hidden");
      }
    };
    const clearErrs = () => {
      form.querySelectorAll("[data-devis-error]").forEach((n) => {
        if (n instanceof HTMLElement) {
          n.textContent = "";
          n.classList.add("hidden");
        }
      });
    };

    let funnelStarted = false;
    form.addEventListener("focusin", () => {
      if (funnelStarted) return;
      funnelStarted = true;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "form_start", form_type: "devis" });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearErrs();
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "form_submit_attempt", form_type: "devis" });

      const hp = form.querySelector('input[name="bot-field-devis"]');
      if (hp instanceof HTMLInputElement && hp.value.trim() !== "") return;

      const siret = form.querySelector(`#${formId}-siret`);
      const digits = (v) => v.replace(/\D/g, "");
      if (siret instanceof HTMLInputElement && digits(siret.value).length !== 14) {
        showErr(`${formId}-siret`, "Le SIRET doit comporter 14 chiffres.");
        return;
      }

      const debut = form.querySelector(`#${formId}-debut`);
      const fin = form.querySelector(`#${formId}-fin`);
      const livraison = form.querySelector(`#${formId}-livraison`);
      const recup = form.querySelector(`#${formId}-recup`);
      if (debut instanceof HTMLInputElement && !debut.value) {
        showErr(`${formId}-debut`, "Sélectionnez une date de départ."); return;
      }
      if (fin instanceof HTMLInputElement && !fin.value) {
        showErr(`${formId}-fin`, "Sélectionnez une date de retour."); return;
      }
      if (livraison instanceof HTMLInputElement && livraison.value.trim().length < 5) {
        showErr(`${formId}-livraison`, "Indiquez une adresse de livraison."); return;
      }
      if (recup instanceof HTMLInputElement && recup.value.trim().length < 5) {
        showErr(`${formId}-recup`, "Indiquez une adresse de récupération."); return;
      }

      const btn = form.querySelector('button[type="submit"]');
      const successEl = document.getElementById(`${formId}-success`);

      if (btn instanceof HTMLButtonElement) { btn.disabled = true; btn.textContent = "Envoi en cours…"; }

      try {
        const data = Object.fromEntries(new FormData(form));
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (res.ok && json.success) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: "devis_submitted", form_type: "b2b" });
          window.location.href = "/merci?type=devis";
        } else {
          throw new Error(json.error || "Erreur inconnue");
        }
      } catch (err) {
        alert((err instanceof Error ? err.message : "Une erreur est survenue.") + " Vous pouvez aussi nous appeler au " + phoneDisplay + ".");
      } finally {
        if (btn instanceof HTMLButtonElement) { btn.disabled = false; btn.textContent = "Demander un devis"; }
      }
    });
  }
</script>
