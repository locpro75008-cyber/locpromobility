---
import type { CollectionEntry } from "astro:content";

type Props = {
  vehicle: CollectionEntry<"vehicules">;
};

const { vehicle } = Astro.props;
const { nom, categorie, description, tarifs, disponible, imageUrl, specs } = vehicle.data;
const autonomie = specs?.find((s) => s.label === "Autonomie")?.value;
const href = `/catalogue/${vehicle.slug}`;
const catLabels: Record<string, string> = {
  "velo-electrique": "Vélo électrique",
  cargo: "Cargo",
  trottinette: "Trottinette",
  gyropode: "Gyropode",
};

// Indicateur d'urgence basé sur un hash du slug (stable et réaliste)
const urgencyScore = vehicle.slug.split("").reduce((acc, c) => acc + c.charCodeAt(0), 0) % 5;
const urgencyLabel =
  urgencyScore === 0 ? "🔥 Très demandé" :
  urgencyScore === 1 ? "⚡ Réservé 3× cette semaine" :
  urgencyScore === 2 ? null :
  urgencyScore === 3 ? "🕐 Dernière disponibilité" :
  null;
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-brand-200 hover:shadow-md"
>
  <a href={href} class="relative block aspect-[4/3] bg-slate-100">
    <img
      src={imageUrl}
      alt={`${nom} — location ${catLabels[categorie] ?? categorie} Paris`}
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <span
      class="absolute left-3 top-3 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-brand-800 shadow-sm"
    >
      {catLabels[categorie] ?? categorie}
    </span>
    {disponible ? (
      <span class="absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full bg-green-600/90 px-3 py-1 text-xs font-semibold text-white shadow-sm">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-white"></span>
        Disponible
      </span>
    ) : (
      <span class="absolute bottom-3 right-3 rounded-full bg-slate-900/80 px-3 py-1 text-xs font-medium text-white">
        Indisponible
      </span>
    )}
  </a>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-2">
      <h2 class="font-display text-lg font-semibold text-ink-900">
        <a href={href} class="hover:text-brand-700">{nom}</a>
      </h2>
      <p class="shrink-0 text-right">
        <span class="text-xs text-slate-400">dès</span>
        <span class="block text-base font-bold text-ink-900 leading-tight">{tarifs[0]?.prix}</span>
      </p>
    </div>
    <p class="mt-2 line-clamp-2 flex-1 text-sm text-slate-600">{description}</p>
    {autonomie && (
      <div class="mt-3 flex items-center gap-1.5 text-xs text-slate-500">
        <svg class="h-3.5 w-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Autonomie {autonomie}
      </div>
    )}
    <dl class="mt-3 flex flex-wrap gap-2 text-xs text-slate-600">
      {
        tarifs.slice(1, 3).map((t) => (
          <div class="rounded-lg bg-slate-50 px-2 py-1">
            <dt class="sr-only">{t.label}</dt>
            <dd>
              <span class="font-medium text-ink-800">{t.prix}</span>
              <span class="text-slate-500"> · {t.label}</span>
            </dd>
          </div>
        ))
      }
    </dl>
    {disponible && urgencyLabel && (
      <p class="mt-3 text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-1.5">
        {urgencyLabel}
      </p>
    )}
    <a
      href={href}
      class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700"
    >
      Voir la fiche
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
