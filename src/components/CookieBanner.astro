<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-[100] hidden border-t border-slate-200 bg-white p-4 shadow-[0_-8px_30px_rgba(15,23,42,0.12)] md:p-6"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-live="polite"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p id="cookie-title" class="font-semibold text-ink-900">Cookies &amp; confidentialité</p>
      <p class="mt-1 max-w-3xl text-sm text-slate-600">
        Nous utilisons des cookies techniques nécessaires au fonctionnement du site et,
        avec votre accord, des mesures d'audience anonymisées. Consultez notre
        <a href="/politique-confidentialite" class="font-medium text-brand-700 underline"
          >politique de confidentialité</a
        >.
      </p>
    </div>
    <div class="flex flex-shrink-0 flex-wrap gap-2">
      <button
        type="button"
        id="cookie-reject"
        class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
      >
        Refuser les cookies non essentiels
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
      >
        Tout accepter
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var KEY = "locpro-cookie-consent";
  var banner = document.getElementById("cookie-banner");
  var accept = document.getElementById("cookie-accept");
  var reject = document.getElementById("cookie-reject");

  window.loadAnalytics = function () {
    if (window.__analyticsLoaded) return;
    window.__analyticsLoaded = true;
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s),
        dl = l != "dataLayer" ? "&l=" + l : "";
      j.async = true;
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, "script", "dataLayer", "GTM-WNMWRMX3");
    (function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          (c[a].q = c[a].q || []).push(arguments);
        };
      t = l.createElement(r);
      t.async = 1;
      t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", "x50lbt19ed");
  };

  function hide() {
    banner && banner.classList.add("hidden");
  }

  try {
    var stored = localStorage.getItem(KEY);
    if (!stored && banner) banner.classList.remove("hidden");
    if (stored === "all") window.loadAnalytics();
  } catch (e) {
    if (banner) banner.classList.remove("hidden");
  }

  accept &&
    accept.addEventListener("click", function () {
      try {
        localStorage.setItem(KEY, "all");
      } catch (e) {}
      window.loadAnalytics();
      hide();
    });

  reject &&
    reject.addEventListener("click", function () {
      try {
        localStorage.setItem(KEY, "essential");
      } catch (e) {}
      hide();
    });
})();
</script>
