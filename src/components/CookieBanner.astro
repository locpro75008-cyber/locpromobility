<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-[100] hidden border-t border-slate-200 bg-white p-4 shadow-[0_-8px_30px_rgba(15,23,42,0.12)] md:p-6"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-live="polite"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p id="cookie-title" class="font-semibold text-ink-900">Cookies &amp; confidentialité</p>
      <p class="mt-1 max-w-3xl text-sm text-slate-600">
        Nous utilisons des cookies techniques nécessaires au fonctionnement du site et,
        avec votre accord, des mesures d’audience anonymisées. Consultez notre
        <a href="/politique-confidentialite" class="font-medium text-brand-700 underline"
          >politique de confidentialité</a
        >.
      </p>
    </div>
    <div class="flex flex-shrink-0 flex-wrap gap-2">
      <button
        type="button"
        id="cookie-reject"
        class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
      >
        Refuser les cookies non essentiels
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
      >
        Tout accepter
      </button>
    </div>
  </div>
</div>

<script>
  const KEY = "locpro-cookie-consent";
  const banner = document.getElementById("cookie-banner");
  const accept = document.getElementById("cookie-accept");
  const reject = document.getElementById("cookie-reject");

  try {
    const stored = localStorage.getItem(KEY);
    if (!stored && banner) {
      banner.classList.remove("hidden");
    }
  } catch {
    if (banner) banner.classList.remove("hidden");
  }

  accept?.addEventListener("click", () => {
    try {
      localStorage.setItem(KEY, "all");
    } catch {
      /* ignore */
    }
    banner?.classList.add("hidden");
  });

  reject?.addEventListener("click", () => {
    try {
      localStorage.setItem(KEY, "essential");
    } catch {
      /* ignore */
    }
    banner?.classList.add("hidden");
  });
</script>
