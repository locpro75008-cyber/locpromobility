---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Page introuvable (404) — LocPro Mobilité"
  description="Cette page n'existe pas ou a été déplacée. Retrouvez nos vélos électriques, tarifs et zones de livraison sur LocPro Mobilité."
  noindex={true}
>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center md:py-28">
    <!-- Illustration -->
    <div class="flex justify-center">
      <div class="flex h-24 w-24 items-center justify-center rounded-full bg-brand-50">
        <svg class="h-12 w-12 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
    </div>

    <p class="mt-6 text-6xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-3 font-display text-2xl font-bold text-ink-900 md:text-3xl">
      Cette page n'existe pas
    </h1>
    <p class="mt-4 text-slate-600">
      La page que vous cherchez a peut-être été déplacée, renommée ou supprimée.<br />
      Pas de panique, le reste du site est là pour vous aider.
    </p>

    <!-- Actions -->
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-brand-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-brand-700"
      >
        Retour à l'accueil
      </a>
      <a
        href="/catalogue"
        class="rounded-full border border-brand-300 px-6 py-3 text-sm font-semibold text-brand-700 transition hover:bg-brand-50"
      >
        Voir le catalogue
      </a>
      <a
        href="/reserver"
        class="rounded-full border border-slate-200 px-6 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
      >
        Réserver
      </a>
    </div>

    <!-- Liens rapides -->
    <div class="mt-12 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
      {[
        { href: "/tarifs", label: "Tarifs" },
        { href: "/zones", label: "Zones desservies" },
        { href: "/faq", label: "FAQ" },
        { href: "/contact", label: "Contact" },
      ].map((l) => (
        <a
          href={l.href}
          class="rounded-xl border border-slate-200 bg-white px-3 py-3 font-medium text-slate-700 shadow-sm transition hover:border-brand-200 hover:text-brand-700"
        >
          {l.label}
        </a>
      ))}
    </div>
  </div>

  <!-- Articles récents -->
  {recentPosts.length > 0 && (
    <section class="border-t border-slate-200 bg-slate-50 py-12">
      <div class="mx-auto max-w-4xl px-4 md:px-6">
        <p class="text-center text-sm font-semibold uppercase tracking-wide text-slate-400">
          En attendant, lisez nos guides
        </p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {recentPosts.map((p) => (
            <li>
              <a
                href={`/blog/${p.slug}`}
                class="block rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-brand-200 hover:shadow-md"
              >
                <p class="text-xs text-slate-400">
                  {p.data.pubDate.toLocaleDateString("fr-FR", { year: "numeric", month: "short" })}
                </p>
                <p class="mt-1 text-sm font-semibold text-ink-900 leading-snug line-clamp-2">
                  {p.data.title}
                </p>
                <span class="mt-2 block text-xs font-semibold text-brand-700">Lire →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
