---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReservationForm from "../components/ReservationForm.astro";

const vehicule = Astro.url.searchParams.get("vehicule") || "";
---

<BaseLayout
  title="Réserver un vélo électrique à Paris — LocPro Mobilité"
  description="Réservez votre vélo électrique en ligne à Paris. Choisissez vos dates, adresse de livraison et modèle. Réponse sous 2h, livraison 24-48h."
>
  <!-- Breadcrumb -->
  <div class="mx-auto max-w-3xl px-4 pt-6 md:px-6">
    <nav aria-label="Fil d'Ariane" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-brand-700">Accueil</a></li>
        <li aria-hidden="true" class="mx-1">›</li>
        <li class="text-slate-800">Réservation</li>
      </ol>
    </nav>
  </div>

  <div class="mx-auto max-w-3xl px-4 py-8 md:px-6 md:py-10">
    <h1 class="font-display text-3xl font-bold text-ink-900">Réserver un vélo électrique</h1>
    <p class="mt-3 text-slate-600">
      Remplissez le formulaire ci-dessous. Notre équipe vous confirme la disponibilité et les détails de livraison <strong>sous 2h</strong> (jours ouvrés).
    </p>

    <!-- Signaux de confiance -->
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {[
        { icon: "⚡", label: "Réponse sous 2h" },
        { icon: "🚚", label: "Livraison 24–48h" },
        { icon: "🔒", label: "Paiement sécurisé" },
        { icon: "↩️", label: "Résiliation flexible" },
      ].map((s) => (
        <div class="flex flex-col items-center gap-1 rounded-xl border border-slate-200 bg-white p-3 text-center shadow-sm">
          <span class="text-xl">{s.icon}</span>
          <span class="text-xs font-semibold text-slate-700">{s.label}</span>
        </div>
      ))}
    </div>
    {
      vehicule && (
        <p class="mt-4 rounded-lg bg-brand-50 px-4 py-3 text-sm text-brand-900">
          Véhicule présélectionné : <strong>{vehicule}</strong> — précisez-le aussi dans le
          message si besoin.
        </p>
      )
    }
    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <ReservationForm id="resa-form" />
    </div>
  </div>
</BaseLayout>

<script define:vars={{ preselect: vehicule }}>
  if (preselect) {
    const sel = document.querySelector("#resa-form-type");
    if (sel instanceof HTMLSelectElement) {
      const map = {
        "locpro-city": "velo-electrique",
        "locpro-urban": "velo-electrique",
        "locpro-urban-plus": "velo-electrique",
        "locpro-fold": "velo-electrique",
        "locpro-cargo-box": "cargo",
        "locpro-cargo-long": "cargo",
        "locpro-cargo-pro": "cargo",
        "locpro-cargo-flex": "cargo",
        "locpro-scoot-s9": "trottinette",
        "locpro-scoot-pro": "trottinette",
        "locpro-gyro-event": "gyropode",
        "locpro-gyro-fleet": "gyropode",
      };
      const v = map[preselect];
      if (v) sel.value = v;
    }
  }
</script>
