---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Location vélo électrique entreprise Paris",
  provider: { "@type": "LocalBusiness", name: "LocPro Mobilité" },
  areaServed: "Paris, Île-de-France",
  description: "Flottes de vélos électriques pour entreprises parisiennes : FMD, livraison, maintenance incluse.",
};
---

<BaseLayout
  title="Location vélo électrique entreprise Paris — Flottes B2B | LocPro Mobilité"
  description="Flottes de vélos électriques pour entreprises à Paris : FMD éligible, livraison en entreprise, maintenance incluse, facturation mensuelle. Devis sous 24h."
  structuredData={serviceLd}
>
  <div class="mx-auto max-w-4xl px-4 py-12 md:px-6 md:py-16">
    <Breadcrumb
      items={[
        { label: "Accueil", href: "/" },
        { label: "Entreprises", href: "/entreprises" },
        { label: "Vélo électrique entreprise Paris" },
      ]}
    />

    <h1 class="font-display text-3xl font-bold text-ink-900 md:text-4xl">
      Vélo électrique pour entreprises à Paris
    </h1>
    <p class="mt-4 text-lg text-slate-600">
      Équipez vos collaborateurs ou votre flotte de livraison avec des vélos et cargos électriques.
      Contrats flexibles, <strong>Forfait Mobilités Durables</strong> compatible, maintenance incluse.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {[
        { t: "FMD éligible", d: "Jusqu'à 800 €/an exonérés par salarié via le Forfait Mobilités Durables." },
        { t: "Livraison en entreprise", d: "Nous livrons et récupérons à votre siège social ou entrepôt." },
        { t: "Tarifs dégressifs", d: "À partir de 3 véhicules : remises volume et facturation mensuelle." },
        { t: "Maintenance & SAV", d: "Révisions, pièces d'usure et remplacement sous 24h inclus." },
      ].map((item) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="font-semibold text-ink-900">{item.t}</h2>
          <p class="mt-2 text-sm text-slate-600">{item.d}</p>
        </div>
      ))}
    </div>

    <section class="mt-12">
      <h2 class="font-display text-xl font-bold text-ink-900">Cas d'usage fréquents</h2>
      <ul class="mt-4 space-y-2 text-slate-600">
        <li>• Navetteurs domicile-travail (FMD)</li>
        <li>• Techniciens et commerciaux terrain</li>
        <li>• Livraisons urbaines (cargo électrique)</li>
        <li>• Politique RSE et bilan carbone</li>
        <li>• Essai avant achat de flotte</li>
      </ul>
    </section>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/devis" class="rounded-xl bg-brand-600 px-6 py-3 text-sm font-bold text-white hover:bg-brand-700">
        Demander un devis flotte
      </a>
      <a href="/blog/forfait-mobilites-durables-2026" class="rounded-xl border border-slate-200 px-6 py-3 text-sm font-semibold text-ink-800 hover:bg-slate-50">
        Guide FMD 2026
      </a>
    </div>
  </div>
</BaseLayout>
