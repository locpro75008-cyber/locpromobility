---
import BaseLayout from "../layouts/BaseLayout.astro";
import DevisForm from "../components/DevisForm.astro";
---

<BaseLayout
  title="Devis B2B — LocPro Mobilité"
  description="Demande de devis flotte : société, SIRET, nombre de véhicules, durée et usage."
>
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
    <h1 class="font-display text-3xl font-bold text-ink-900">Devis entreprise</h1>
    <p class="mt-3 text-slate-600">
      Décrivez votre besoin : notre équipe vous répond sous 48 h avec une proposition
      adaptée (contrat, maintenance, assurance).
    </p>
    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <DevisForm id="devis-page" />
    </div>
  </div>
</BaseLayout>
