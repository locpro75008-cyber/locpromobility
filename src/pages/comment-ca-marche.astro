---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const etapes = [
  {
    num: "01",
    titre: "Choisissez votre véhicule",
    desc: "Parcourez notre catalogue de vélos électriques, cargos et trottinettes. Filtrez par usage, autonomie et budget. Chaque fiche détaille les specs, l'autonomie réelle et les tarifs par durée.",
    icon: "🚲",
    cta: { href: "/catalogue", label: "Voir le catalogue" },
  },
  {
    num: "02",
    titre: "Sélectionnez vos dates et adresse",
    desc: "Indiquez vos dates de départ et retour, votre adresse de livraison et de récupération. Notre formulaire inclut une saisie semi-automatique des adresses parisiennes pour gagner du temps.",
    icon: "📅",
    cta: { href: "/reserver", label: "Réserver maintenant" },
  },
  {
    num: "03",
    titre: "Validation sous 2h",
    desc: "Notre équipe confirme la disponibilité et vous envoie un récapitulatif par email. Pour les entreprises, un contrat de location personnalisé est établi sous 24h.",
    icon: "✅",
    cta: null,
  },
  {
    num: "04",
    titre: "Livraison à votre porte",
    desc: "Nous livrons votre véhicule à l'adresse indiquée, réglé, chargé et prêt à rouler. Délai : 24 à 48h pour Paris et petite couronne. La prise en main se fait en 5 minutes.",
    icon: "🏠",
    cta: null,
  },
  {
    num: "05",
    titre: "Profitez — on gère le reste",
    desc: "Panne, crevaison, assistance technique : appelez notre ligne dédiée 7j/7. En cas d'immobilisation > 48h, un véhicule de remplacement vous est fourni sans frais supplémentaires.",
    icon: "🛠️",
    cta: null,
  },
  {
    num: "06",
    titre: "Récupération sans effort",
    desc: "À la fin de votre location, nous récupérons le véhicule à l'adresse de votre choix. Pas de dépôt en agence, pas de contrainte logistique.",
    icon: "🔄",
    cta: null,
  },
];

const faqs = [
  { q: "Combien de temps à l'avance faut-il réserver ?", a: "Idéalement 48h à l'avance, mais nous pouvons parfois livrer le jour même pour les urgences. Appelez-nous au 01 70 95 56 61." },
  { q: "Puis-je prolonger ma location ?", a: "Oui, contactez-nous avant la date de retour initiale. Prolongation possible sous réserve de disponibilité, au même tarif." },
  { q: "Que se passe-t-il en cas de vol ?", a: "Déposez plainte et contactez-nous immédiatement. Selon la formule choisie, votre assurance vol couvre tout ou partie du préjudice." },
  { q: "Y a-t-il un kilométrage limité ?", a: "Non, aucune limite de kilométrage. Roulez autant que vous le souhaitez pendant la durée de votre location." },
];

const howToLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "Comment louer un vélo électrique à Paris avec LocPro Mobilité",
  description: "Location de vélo électrique à Paris en 6 étapes : sélection, réservation, livraison 24–48h, assistance 7j/7 et récupération sans contrainte.",
  totalTime: "PT5M",
  supply: [
    { "@type": "HowToSupply", name: "Pièce d'identité" },
    { "@type": "HowToSupply", name: "Justificatif de domicile" },
    { "@type": "HowToSupply", name: "Moyen de paiement" },
  ],
  step: etapes.map((e, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: e.titre,
    text: e.desc,
    url: `https://locpromobility.fr/comment-ca-marche#etape-${e.num}`,
  })),
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Comment ça marche — Location vélo électrique Paris | LocPro Mobilité"
  description="Location vélo électrique à Paris en 6 étapes simples : catalogue, réservation en ligne, livraison 48h, assistance 7j/7, récupération sans contrainte."
  structuredData={[howToLd, faqLd]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-4 md:px-6">
      <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "Comment ça marche" }]} />
    </div>
    <div class="mx-auto max-w-3xl px-4 text-center md:px-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">Simple. Rapide. Sans prise de tête.</p>
      <h1 class="mt-2 font-display text-4xl font-bold text-ink-900 md:text-5xl">
        Comment ça marche ?
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        De la sélection du véhicule à la récupération, voici comment fonctionne votre location de bout en bout.
      </p>
    </div>
  </section>

  <!-- Étapes -->
  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <div class="space-y-12">
      {etapes.map((e, i) => (
        <div class={`flex gap-6 md:gap-10 ${i % 2 === 1 ? "md:flex-row-reverse" : ""}`}>
          <!-- Icône / numéro -->
          <div class="flex flex-col items-center gap-2">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-brand-600 text-3xl shadow-md">
              {e.icon}
            </div>
            {i < etapes.length - 1 && (
              <div class="w-0.5 flex-1 bg-gradient-to-b from-brand-300 to-transparent"></div>
            )}
          </div>
          <!-- Contenu -->
          <div class="pb-4 pt-2">
            <p class="text-xs font-bold uppercase tracking-widest text-brand-600">Étape {e.num}</p>
            <h2 class="mt-1 font-display text-xl font-bold text-ink-900">{e.titre}</h2>
            <p class="mt-2 text-slate-600 leading-relaxed">{e.desc}</p>
            {e.cta && (
              <a href={e.cta.href} class="mt-4 inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">
                {e.cta.label} →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Garanties -->
  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="text-center font-display text-2xl font-bold text-ink-900">Ce qui est toujours inclus</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { icon: "🚚", titre: "Livraison incluse", desc: "Pour les locations LLD. Paris et petite couronne." },
          { icon: "🔧", titre: "Maintenance incluse", desc: "Révisions et pièces d'usure pris en charge." },
          { icon: "📞", titre: "Assistance 7j/7", desc: "Ligne dédiée disponible pendant votre location." },
          { icon: "🔄", titre: "Vélo de remplacement", desc: "Fourni sous 48h si immobilisation confirmée." },
        ].map((g) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
            <p class="text-3xl">{g.icon}</p>
            <p class="mt-3 font-semibold text-ink-900">{g.titre}</p>
            <p class="mt-1 text-sm text-slate-500">{g.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mini FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <h2 class="font-display text-2xl font-bold text-ink-900">Questions pratiques</h2>
    <dl class="mt-8 space-y-4">
      {faqs.map((f) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <dt class="font-semibold text-ink-900">{f.q}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-slate-600">{f.a}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-6 text-center">
      <a href="/faq" class="text-sm font-semibold text-brand-700 hover:underline">Toute la FAQ →</a>
    </p>
  </section>

  <!-- CTA final -->
  <section class="border-t border-slate-200 bg-white py-12 text-center">
    <div class="mx-auto max-w-xl px-4">
      <h2 class="font-display text-2xl font-bold text-ink-900">Prêt à rouler ?</h2>
      <p class="mt-2 text-slate-600">Livraison sous 48h à Paris. Entretien inclus. Résiliation flexible.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/reserver" class="rounded-xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-700">Réserver un vélo</a>
        <a href="/entreprises" class="rounded-xl border border-slate-200 px-6 py-3 text-sm font-semibold text-ink-800 transition hover:border-brand-200 hover:bg-brand-50">Offre entreprises</a>
      </div>
    </div>
  </section>
</BaseLayout>
