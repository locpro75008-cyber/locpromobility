---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { locations } from "../../data/locations";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return locations.map((loc) => ({
    params: { ville: loc.slug },
    props: { loc },
  }));
}

const { loc } = Astro.props;
const vehicules = await getCollection("vehicules");
const disponibles = vehicules.filter((v) => v.data.disponible);

const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "LocPro Mobilité",
  description: `Location de vélos électriques, cargos et trottinettes à ${loc.nom}. Livraison à domicile.`,
  url: `https://locpromobility.fr/location/${loc.slug}`,
  telephone: "+33170955661",
  email: "contact@locpromobility.fr",
  address: {
    "@type": "PostalAddress",
    streetAddress: "60 rue François 1er",
    addressLocality: "Paris",
    postalCode: "75008",
    addressCountry: "FR",
  },
  areaServed: {
    "@type": "City",
    name: loc.nom,
    postalCode: loc.codePostal,
  },
  priceRange: "€€",
};
---

<BaseLayout
  title={`Location vélo électrique ${loc.nom} — LocPro Mobilité`}
  description={loc.metaDescription}
  structuredData={localBusinessLd}
>
  <div class="mx-auto max-w-5xl px-4 py-10 md:px-6 md:py-14">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-500" aria-label="Fil d'Ariane">
      <a href="/" class="hover:text-brand-700">Accueil</a>
      <span>/</span>
      <a href="/zones" class="hover:text-brand-700">Zones desservies</a>
      <span>/</span>
      <span class="font-medium text-slate-800">{loc.nom}</span>
    </nav>

    <!-- Hero -->
    <div class="mt-8 rounded-2xl bg-gradient-to-br from-brand-700 to-brand-900 px-8 py-10 text-white">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          {loc.type === "arrondissement" ? (
            <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-semibold">Paris</span>
          ) : (
            <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-semibold">{loc.departement}</span>
          )}
          <h1 class="mt-3 font-display text-3xl font-bold md:text-4xl">
            Location vélo électrique<br />{loc.nom}
          </h1>
          <p class="mt-3 max-w-xl text-brand-100 text-base leading-relaxed">{loc.intro}</p>
        </div>
        <div class="flex flex-col gap-2 shrink-0">
          <a
            href="/reserver"
            class="rounded-xl bg-white px-5 py-3 text-sm font-bold text-brand-800 shadow-sm transition hover:bg-brand-50"
          >
            Réserver maintenant
          </a>
          <a
            href="tel:+33170955661"
            class="rounded-xl border border-white/30 px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-white/10"
          >
            01 70 95 56 61
          </a>
        </div>
      </div>
    </div>

    <!-- Contenu principal + sidebar -->
    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_320px]">
      <div class="space-y-10">

        <!-- Pourquoi le vélo électrique ici -->
        <section>
          <h2 class="font-display text-xl font-bold text-ink-900">
            Pourquoi louer un vélo électrique à {loc.nom} ?
          </h2>
          <p class="mt-3 text-slate-600 leading-relaxed">
            {loc.nom} est une zone idéale pour se déplacer à vélo électrique. Nos véhicules sont livrés
            directement à votre adresse — domicile, bureau ou hôtel — avec casque et antivol inclus.
            <strong class="text-ink-900"> {loc.distanceAgence}</strong>.
          </p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <!-- Usages -->
            <div class="rounded-2xl border border-slate-200 bg-white p-5">
              <h3 class="flex items-center gap-2 text-sm font-semibold text-ink-900">
                <svg class="h-4 w-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Usages populaires
              </h3>
              <ul class="mt-3 space-y-1.5">
                {loc.usages.map((u) => (
                  <li class="flex items-center gap-2 text-sm text-slate-600">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-400 shrink-0"></span>
                    {u}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Points d'intérêt -->
            <div class="rounded-2xl border border-slate-200 bg-white p-5">
              <h3 class="flex items-center gap-2 text-sm font-semibold text-ink-900">
                <svg class="h-4 w-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                À proximité
              </h3>
              <ul class="mt-3 space-y-1.5">
                {loc.landmarks.map((l) => (
                  <li class="text-sm text-slate-600">📍 {l}</li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Transports -->
          <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4">
            <h3 class="text-sm font-semibold text-ink-900">🚇 Stations métro / RER à proximité</h3>
            <div class="mt-2 flex flex-wrap gap-2">
              {loc.metros.map((m) => (
                <span class="rounded-full bg-white border border-slate-200 px-3 py-1 text-xs font-medium text-slate-700 shadow-sm">
                  {m}
                </span>
              ))}
            </div>
          </div>
        </section>

        <!-- Nos véhicules disponibles -->
        <section>
          <h2 class="font-display text-xl font-bold text-ink-900">
            Nos véhicules disponibles pour {loc.nom}
          </h2>
          <p class="mt-2 text-sm text-slate-500">
            Tous nos véhicules sont livrés avec antivol, chargeur et assistance en cas de panne.
          </p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {disponibles.map((v) => (
              <a
                href={`/catalogue/${v.slug}`}
                class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-brand-300 hover:shadow-md"
              >
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                  <svg class="h-6 w-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="font-semibold text-ink-900 group-hover:text-brand-700 truncate">{v.data.nom}</p>
                  <p class="mt-0.5 text-xs text-slate-500">Dès {v.data.tarifs[0]?.prix}</p>
                </div>
                <svg class="ml-auto h-4 w-4 shrink-0 text-slate-300 group-hover:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </section>

        <!-- Comment ça marche -->
        <section>
          <h2 class="font-display text-xl font-bold text-ink-900">
            Comment louer un vélo électrique à {loc.nom} ?
          </h2>
          <ol class="mt-5 space-y-4">
            {[
              { n: "1", titre: "Choisissez votre véhicule", texte: "Sélectionnez le modèle adapté à vos besoins parmi notre catalogue (vélo, cargo, trottinette)." },
              { n: "2", titre: "Réservez en ligne", texte: "Remplissez le formulaire de réservation avec vos dates et adresse de livraison à " + loc.nom + "." },
              { n: "3", titre: "Livraison à votre porte", texte: "Nous livrons à " + loc.nom + " sous 24–48h. Prise en main incluse sur place." },
              { n: "4", titre: "Roulez en toute sérénité", texte: "Maintenance, assistance dépannage et remplacement sous 24h inclus dans toutes nos formules." },
            ].map((step) => (
              <li class="flex gap-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">{step.n}</span>
                <div>
                  <p class="font-semibold text-ink-900">{step.titre}</p>
                  <p class="mt-0.5 text-sm text-slate-600">{step.texte}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- FAQ locale -->
        <section>
          <h2 class="font-display text-xl font-bold text-ink-900">
            Questions fréquentes — {loc.nom}
          </h2>
          <div class="mt-4 space-y-3">
            {[
              {
                q: `Livrez-vous à ${loc.nom} ?`,
                r: `Oui, nous livrons à ${loc.nom} et dans toute l'Île-de-France. La livraison est généralement effectuée sous 24 à 48h après confirmation de votre réservation.`,
              },
              {
                q: `Quel est le tarif minimum pour une location à ${loc.nom} ?`,
                r: "Nos tarifs commencent à 19€/jour pour une trottinette électrique. La location à la semaine et au mois offre des réductions significatives. Consultez notre page tarifs pour le détail.",
              },
              {
                q: "Que se passe-t-il en cas de panne ?",
                r: "Notre équipe technique intervient dans un délai maximum de 24h. En cas de panne immobilisante, un véhicule de remplacement est mis à disposition gratuitement.",
              },
            ].map((faq) => (
              <details class="group rounded-xl border border-slate-200 bg-white">
                <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-semibold text-ink-900 marker:content-none">
                  {faq.q}
                  <svg class="h-4 w-4 shrink-0 text-slate-400 transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <p class="border-t border-slate-100 px-5 py-4 text-sm text-slate-600 leading-relaxed">{faq.r}</p>
              </details>
            ))}
          </div>
        </section>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-5 lg:sticky lg:top-6 lg:self-start">
        <div class="rounded-2xl border border-brand-200 bg-brand-50 p-5">
          <p class="text-sm font-semibold text-brand-900">📍 Livraison à {loc.nom}</p>
          <p class="mt-1 text-xs text-brand-700">{loc.distanceAgence}</p>
          <a
            href="/reserver"
            class="mt-4 flex w-full items-center justify-center rounded-xl bg-brand-600 px-4 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-brand-700"
          >
            Réserver maintenant
          </a>
          <a
            href="/devis"
            class="mt-2 flex w-full items-center justify-center rounded-xl border border-brand-300 bg-white px-4 py-3 text-sm font-semibold text-brand-800 transition hover:bg-brand-50"
          >
            Devis entreprise / flotte
          </a>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 space-y-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Inclus dans toutes les formules</p>
          {[
            "Livraison à domicile",
            "Antivol et chargeur",
            "Prise en main sur place",
            "Assistance dépannage 7j/7",
            "Remplacement sous 24h",
          ].map((item) => (
            <div class="flex items-center gap-2 text-sm text-slate-700">
              <svg class="h-4 w-4 shrink-0 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </div>
          ))}
        </div>

        <div class="rounded-xl bg-slate-50 p-4 text-center">
          <p class="text-xs text-slate-500">Besoin d'un devis rapide ?</p>
          <a href="tel:+33170955661" class="mt-1 block text-lg font-bold text-brand-700 hover:underline">
            01 70 95 56 61
          </a>
          <p class="text-xs text-slate-400">Lun–Sam 9h–19h</p>
        </div>

        <!-- Autres zones -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Autres zones desservies</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {locations
              .filter((l) => l.slug !== loc.slug)
              .slice(0, 8)
              .map((l) => (
                <a
                  href={`/location/${l.slug}`}
                  class="rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600 hover:border-brand-300 hover:text-brand-700 transition"
                >
                  {l.nom.replace(" arrondissement", "")}
                </a>
              ))}
            <a href="/zones" class="rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 hover:bg-brand-100 transition">
              Voir toutes →
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
