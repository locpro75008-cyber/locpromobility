---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Location vélo électrique à Paris — LocPro Mobilité"
  description="Louer un vélo électrique à Paris : agence, livraison possible, court et long terme. B2C et B2B."
>
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
    <h1 class="font-display text-3xl font-bold text-ink-900">
      Location vélo électrique à Paris
    </h1>
    <p class="mt-4 text-lg text-slate-600">
      LocPro Mobilité propose des <strong>vélos électriques</strong> pour vos trajets urbains,
      missions professionnelles ou essais avant achat. Retrait en agence centre-ville ou
      livraison selon zone et planning.
    </p>
    <ul class="mt-8 list-inside list-disc space-y-2 text-slate-700">
      <li>Court terme (journalier) pour touristes et événements</li>
      <li>Moyen terme pour étudiants, expatriés ou projets temporaires</li>
      <li>Contrats longue durée entreprises avec maintenance</li>
    </ul>
    <p class="mt-8">
      <a
        href="/catalogue"
        class="inline-flex rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700"
        >Voir le catalogue</a
      >
    </p>
  </div>
</BaseLayout>
