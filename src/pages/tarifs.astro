---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
  buildCalcTarifs,
  buildCategoryRanges,
  vehicleTariffRow,
} from "../lib/tariff-utils";

const vehicules = (await getCollection("vehicules")).sort((a, b) =>
  a.data.nom.localeCompare(b.data.nom, "fr"),
);
const rows = vehicules.map(vehicleTariffRow);
const ranges = buildCategoryRanges(vehicules);
const calcTarifs = buildCalcTarifs(vehicules);
---

<BaseLayout
  title="Tarifs location mobilité électrique Paris — LocPro Mobilité"
  description="Tarifs transparents à Paris et en Île-de-France : dès 15 €/jour (trottinette), 22 €/jour (vélo), 55 €/jour (cargo). Livraison, maintenance et assistance incluses en LLD."
>
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <nav aria-label="Fil d'Ariane" class="mb-6 text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-brand-700">Accueil</a></li>
        <li aria-hidden="true" class="mx-1">›</li>
        <li class="text-slate-800">Tarifs</li>
      </ol>
    </nav>
    <h1 class="font-display text-3xl font-bold text-ink-900 md:text-4xl">Tarifs</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Tarifs transparents pour Paris et l'Île-de-France — courte, moyenne ou longue durée.
      Livraison, prise en main et maintenance incluses en location longue durée.
      Tarifs dégressifs pour les flottes sur <a href="/devis" class="font-medium text-brand-700 underline">devis</a>.
    </p>

    <ul class="mt-5 flex flex-wrap gap-2 text-xs font-medium text-slate-600">
      {["Livraison à domicile (LLD)", "Maintenance incluse", "Assistance 7j/7", "Résiliation flexible"].map((item) => (
        <li class="rounded-full border border-brand-100 bg-brand-50 px-3 py-1 text-brand-800">{item}</li>
      ))}
    </ul>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="font-display text-lg font-semibold text-ink-900">Court terme</h2>
        <p class="mt-1 text-sm text-slate-500">&lt; 1 semaine</p>
        <ul class="mt-6 space-y-3 text-sm">
          <li class="flex justify-between gap-2"><span>Trottinette / jour</span><span class="font-semibold">{ranges.court.trottinette}</span></li>
          <li class="flex justify-between gap-2"><span>Vélo / jour</span><span class="font-semibold">{ranges.court.velo}</span></li>
          <li class="flex justify-between gap-2"><span>Cargo / jour</span><span class="font-semibold">{ranges.court.cargo}</span></li>
          <li class="flex justify-between gap-2"><span>Gyropode / jour</span><span class="font-semibold">{ranges.court.gyropode}</span></li>
        </ul>
      </section>
      <section class="rounded-2xl border-2 border-brand-200 bg-brand-50/60 p-6 shadow-sm">
        <h2 class="font-display text-lg font-semibold text-ink-900">Moyen terme</h2>
        <p class="mt-1 text-sm text-slate-500">1 semaine à 3 mois</p>
        <ul class="mt-6 space-y-3 text-sm">
          <li class="flex justify-between gap-2"><span>Trottinette / mois</span><span class="font-semibold">{ranges.moyen.trottinette}</span></li>
          <li class="flex justify-between gap-2"><span>Vélo / mois</span><span class="font-semibold">{ranges.moyen.velo}</span></li>
          <li class="flex justify-between gap-2"><span>Cargo / mois</span><span class="font-semibold">{ranges.moyen.cargo}</span></li>
          <li class="flex justify-between gap-2"><span>Gyropode / mois</span><span class="font-semibold">{ranges.moyen.gyropode}</span></li>
        </ul>
      </section>
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="font-display text-lg font-semibold text-ink-900">Long terme</h2>
        <p class="mt-1 text-sm text-slate-500">&gt; 3 mois — LLD</p>
        <ul class="mt-6 space-y-3 text-sm">
          <li class="flex justify-between gap-2"><span>Trottinette</span><span class="font-semibold">{ranges.long.trottinette}{ranges.long.trottinette !== "—" ? "/mois" : ""}</span></li>
          <li class="flex justify-between gap-2"><span>Vélo</span><span class="font-semibold">{ranges.long.velo}{ranges.long.velo !== "—" ? "/mois" : ""}</span></li>
          <li class="flex justify-between gap-2"><span>Cargo</span><span class="font-semibold">{ranges.long.cargo}{ranges.long.cargo !== "—" ? "/mois" : ""}</span></li>
        </ul>
        <a href="/devis" class="mt-6 inline-flex rounded-xl bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800">Devis flotte B2B</a>
      </section>
    </div>

    <section class="mt-16">
      <h2 class="font-display text-2xl font-bold text-ink-900">Tarifs par modèle</h2>
      <p class="mt-2 text-sm text-slate-500">12 modèles disponibles à la location. <a href="/catalogue" class="text-brand-700 underline">Voir le catalogue →</a></p>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
        <table class="min-w-full bg-white text-sm">
          <thead>
            <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
              <th class="px-4 py-3">Modèle</th>
              <th class="px-4 py-3">Référence</th>
              <th class="px-4 py-3">Jour</th>
              <th class="px-4 py-3">Semaine</th>
              <th class="px-4 py-3">Mois</th>
              <th class="px-4 py-3">LLD</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {rows.map((row) => (
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 font-medium text-ink-900">{row.nom}</td>
                <td class="px-4 py-3 text-slate-500">{row.ref}</td>
                <td class="px-4 py-3">{row.jour}</td>
                <td class="px-4 py-3">{row.semaine}</td>
                <td class="px-4 py-3">{row.mois}</td>
                <td class="px-4 py-3 font-semibold text-brand-700">
                  {row.lldIsDevis ? row.lld : `${row.lld}/mois`}
                </td>
                <td class="px-4 py-3">
                  <a href={`/reserver?vehicule=${row.slug}`} class="text-xs font-semibold text-brand-700 hover:underline">Réserver</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-16" id="calculateur">
      <h2 class="font-display text-2xl font-bold text-ink-900">Calculateur de prix</h2>
      <p class="mt-2 text-sm text-slate-500">Estimez votre budget, puis réservez en ligne — confirmation sous 2 h ouvrées.</p>

      <div class="mt-6 rounded-2xl border border-brand-100 bg-brand-50/50 p-6 md:p-8">
        <div class="grid gap-6 md:grid-cols-3">
          <div>
            <label for="calc-vehicule" class="mb-2 block text-sm font-semibold text-ink-800">Type de véhicule</label>
            <select id="calc-vehicule" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200">
              <option value="trottinette">Trottinette électrique</option>
              <option value="velo-city">Vélo City (entrée)</option>
              <option value="velo" selected>Vélo Urban (standard)</option>
              <option value="velo-plus">Vélo Urban+ (premium)</option>
              <option value="cargo">Cargo électrique</option>
              <option value="gyropode">Gyropode</option>
            </select>
          </div>
          <div>
            <label for="calc-duree" class="mb-2 block text-sm font-semibold text-ink-800">
              Durée : <span id="calc-duree-label" class="text-brand-700">30 jours</span>
            </label>
            <input type="range" id="calc-duree" min="1" max="365" value="30" class="w-full accent-brand-600" />
            <div class="mt-1 flex justify-between text-xs text-slate-400"><span>1 jour</span><span>1 an</span></div>
          </div>
          <div class="flex flex-col items-center justify-center rounded-xl border border-brand-200 bg-white p-5 text-center shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Estimation</p>
            <p id="calc-result" class="mt-1 font-display text-4xl font-bold text-brand-700">99 €</p>
            <p id="calc-unit" class="text-xs text-slate-500">par mois · maintenance incluse</p>
            <a id="calc-reserve" href="/reserver?vehicule=locpro-urban" class="mt-4 w-full rounded-xl bg-brand-600 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 text-center">
              Réserver ce véhicule
            </a>
          </div>
        </div>

        <div id="calc-fmd" class="mt-4 hidden rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
          💡 Salarié ? Avec le <strong>Forfait Mobilités Durables</strong>, votre employeur peut prendre en charge jusqu'à <strong>800 €/an</strong> — soit <strong id="calc-fmd-net"></strong>/mois nets. <a href="/blog/forfait-mobilites-durables-2026" class="font-semibold underline">En savoir plus →</a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ calcTarifs }}>
  (function () {
    const tarifs = calcTarifs;
    const sel = document.getElementById("calc-vehicule");
    const range = document.getElementById("calc-duree");
    const label = document.getElementById("calc-duree-label");
    const result = document.getElementById("calc-result");
    const unit = document.getElementById("calc-unit");
    const reserve = document.getElementById("calc-reserve");
    const fmdBox = document.getElementById("calc-fmd");
    const fmdNet = document.getElementById("calc-fmd-net");

    function updateReserveLink(key, days) {
      if (!reserve || !tarifs[key]) return;
      const slug = tarifs[key].slug;
      let dureeLabel = days + " jours";
      if (days === 1) dureeLabel = "1 jour";
      else if (days <= 27) dureeLabel = Math.round(days / 7) + " semaine(s)";
      else dureeLabel = Math.round(days / 30) + " mois";
      reserve.href = "/reserver?vehicule=" + encodeURIComponent(slug) + "&duree=" + encodeURIComponent(dureeLabel);
    }

    function update() {
      const v = sel.value;
      const days = parseInt(range.value, 10);
      const t = tarifs[v];
      if (!t) return;
      let prix, unitText, showFmd = false;

      if (days === 1) {
        prix = t.jour; unitText = "pour 1 jour · tout inclus"; label.textContent = "1 jour";
      } else if (days <= 6) {
        prix = t.jour * days; unitText = "pour " + days + " jours · tout inclus"; label.textContent = days + " jours";
      } else if (days <= 27) {
        const weeks = Math.round(days / 7);
        prix = t.semaine * weeks;
        unitText = "pour " + weeks + " semaine" + (weeks > 1 ? "s" : "") + " · maintenance incluse";
        label.textContent = weeks + " semaine" + (weeks > 1 ? "s" : "");
      } else if (days <= 89) {
        const months = Math.round(days / 30);
        prix = t.mois * months;
        unitText = "pour " + months + " mois · maintenance incluse";
        label.textContent = months + " mois";
        showFmd = true;
      } else {
        const months = Math.round(days / 30);
        prix = t.an * months;
        unitText = "pour " + months + " mois (tarif LLD) · tout inclus";
        label.textContent = months + " mois";
        showFmd = true;
      }

      result.textContent = prix.toLocaleString("fr-FR") + " €";
      unit.textContent = unitText;
      updateReserveLink(v, days);

      if (showFmd && fmdBox && fmdNet) {
        const netParMois = Math.max(0, Math.round(prix / Math.round(days / 30)) - Math.round(800 / 12));
        fmdNet.textContent = netParMois + " €";
        fmdBox.classList.remove("hidden");
      } else if (fmdBox) {
        fmdBox.classList.add("hidden");
      }
    }

    if (sel) sel.addEventListener("change", update);
    if (range) range.addEventListener("input", update);
    update();
  })();
  </script>
</BaseLayout>
