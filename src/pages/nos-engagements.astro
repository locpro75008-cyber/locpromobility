---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import TrustBadges from "../components/TrustBadges.astro";

const engagements = [
  {
    titre: "Livraison sous 48h",
    desc: "Nous livrons à votre adresse à Paris et en petite couronne sous 24 à 48h après confirmation. Véhicule chargé, réglé et prêt à rouler.",
    icon: "🚚",
  },
  {
    titre: "Assistance 7j/7",
    desc: "Une ligne dédiée pendant vos heures de location. Intervention sous 4h en Île-de-France pour toute panne ou crevaison.",
    icon: "📞",
  },
  {
    titre: "Maintenance incluse",
    desc: "Révisions, pièces d'usure et réglages pris en charge dans nos formules longue durée et contrats entreprise.",
    icon: "🔧",
  },
  {
    titre: "Vélo de remplacement",
    desc: "Si votre véhicule est immobilisé plus de 24h, nous vous fournissons un remplacement sans frais supplémentaires.",
    icon: "🔄",
  },
  {
    titre: "Transparence tarifaire",
    desc: "Prix affichés TTC, caution restituée sous 5 jours, aucun frais caché. Annulation gratuite jusqu'à 48h avant.",
    icon: "📋",
  },
  {
    titre: "Réponse sous 2h",
    desc: "Toute demande de réservation ou devis reçoit une réponse de notre équipe en moins de 2h en semaine.",
    icon: "⚡",
  },
];
---

<BaseLayout
  title="Nos engagements — LocPro Mobilité"
  description="Livraison 48h, assistance 7j/7, maintenance incluse, remplacement sous 24h : découvrez les garanties LocPro Mobilité pour votre location de vélo électrique."
>
  <div class="mx-auto max-w-4xl px-4 py-12 md:px-6 md:py-16">
    <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "Nos engagements" }]} />

    <h1 class="font-display text-3xl font-bold text-ink-900 md:text-4xl">Nos engagements</h1>
    <p class="mt-3 text-lg text-slate-600">
      Louer un vélo électrique, c'est faire confiance. Voici ce que nous garantissons à chaque client.
    </p>

    <div class="mt-8">
      <TrustBadges />
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {engagements.map((e) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <span class="text-2xl" aria-hidden="true">{e.icon}</span>
          <h2 class="mt-3 font-display text-lg font-bold text-ink-900">{e.titre}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{e.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/reserver" class="rounded-xl bg-brand-600 px-6 py-3 text-sm font-bold text-white hover:bg-brand-700">
        Réserver maintenant
      </a>
    </div>
  </div>
</BaseLayout>
