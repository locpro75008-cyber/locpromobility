---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const valeurs = [
  {
    icon: "⚡",
    titre: "Mobilité sans compromis",
    texte: "Nous croyons que se déplacer en ville ne devrait jamais être une contrainte. Chaque véhicule de notre flotte est sélectionné pour sa fiabilité, son confort et son autonomie réelle.",
  },
  {
    icon: "🌿",
    titre: "Impact environnemental positif",
    texte: "Chaque kilomètre parcouru en VAE économise en moyenne 180 g de CO₂ par rapport à une voiture thermique. Notre mission : remplacer les trajets polluants par une alternative désirable.",
  },
  {
    icon: "🤝",
    titre: "Service humain",
    texte: "Derrière chaque location, il y a une vraie personne disponible. Livraison, assistance, remplacement en cas de panne : nous gérons tout pour que vous rouliez l'esprit libre.",
  },
  {
    icon: "🏢",
    titre: "Expertise B2B",
    texte: "Flottes d'entreprise, cargos de livraison, mobilité salariés… Nous accompagnons les professionnels parisiens dans leur transition vers une mobilité plus durable et rentable.",
  },
];

const chiffres = [
  { valeur: "500+", label: "Clients actifs" },
  { valeur: "4,9/5", label: "Note moyenne Google" },
  { valeur: "48h", label: "Délai de livraison max" },
  { valeur: "2023", label: "Année de création" },
];

const orgaSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "À propos de LocPro Mobilité",
  description: "L'histoire et les valeurs de LocPro Mobilité, spécialiste de la location de vélos électriques à Paris.",
  url: "https://locpromobility.fr/a-propos",
  about: {
    "@type": "Organization",
    name: "LocPro Mobilité",
    foundingDate: "2023-12-21",
    address: {
      "@type": "PostalAddress",
      streetAddress: "60 rue François 1er",
      addressLocality: "Paris",
      postalCode: "75008",
      addressCountry: "FR",
    },
  },
};
---

<BaseLayout
  title="À propos — LocPro Mobilité, spécialiste location vélo électrique Paris"
  description="Découvrez l'histoire de LocPro Mobilité, notre mission, nos valeurs et notre engagement pour une mobilité urbaine durable à Paris depuis 2023."
  structuredData={orgaSchema}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-4 md:px-6">
      <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "À propos" }]} />
    </div>
    <div class="mx-auto max-w-4xl px-4 text-center md:px-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">Notre histoire</p>
      <h1 class="mt-2 font-display text-4xl font-bold text-ink-900 md:text-5xl">
        La mobilité électrique,<br class="hidden md:block" /> accessible à tous
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        LocPro Mobilité est née d'un constat simple : les Parisiens méritent une alternative crédible à la voiture et aux transports en commun bondés. Une alternative propre, rapide, abordable — et sans les contraintes de l'achat.
      </p>
    </div>
  </section>

  <!-- Notre mission -->
  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <div class="grid gap-12 md:grid-cols-2 md:items-center">
      <div>
        <h2 class="font-display text-2xl font-bold text-ink-900 md:text-3xl">Pourquoi LocPro Mobilité ?</h2>
        <p class="mt-4 text-slate-600">
          Fondée en décembre 2023 et immatriculée au RCS de Paris (SIREN 982 806 200), LocPro Mobilité opère depuis le 8e arrondissement de Paris.
        </p>
        <p class="mt-4 text-slate-600">
          Notre modèle est simple : nous gérons l'intégralité du cycle de vie du véhicule — achat, entretien, maintenance, assurance, livraison — pour que vous n'ayez qu'à pédaler.
        </p>
        <p class="mt-4 text-slate-600">
          Nous servons aussi bien les particuliers cherchant un vélo pour leurs trajets quotidiens que les entreprises souhaitant équiper leurs collaborateurs ou remplacer des véhicules de livraison polluants.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {chiffres.map((c) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
            <p class="font-display text-3xl font-bold text-brand-700">{c.valeur}</p>
            <p class="mt-1 text-sm text-slate-500">{c.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nos valeurs -->
  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="text-center font-display text-2xl font-bold text-ink-900 md:text-3xl">Nos valeurs</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {valeurs.map((v) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-3xl">{v.icon}</p>
            <h3 class="mt-3 font-semibold text-ink-900">{v.titre}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{v.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Notre engagement ZFE -->
  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <div class="rounded-2xl bg-brand-600 p-8 text-white md:p-12">
      <h2 class="font-display text-2xl font-bold md:text-3xl">Notre engagement pour Paris</h2>
      <p class="mt-4 text-brand-100">
        Face au renforcement des Zones à Faibles Émissions (ZFE) et à la congestion chronique de Paris, nous croyons que le vélo électrique n'est pas un gadget — c'est l'infrastructure de transport du futur.
      </p>
      <p class="mt-4 text-brand-100">
        Chaque véhicule que nous déployons remplace en moyenne <strong class="text-white">1,4 trajet automobile par jour</strong>. Sur une flotte de 50 véhicules, c'est l'équivalent de <strong class="text-white">25 tonnes de CO₂ économisées chaque année</strong>.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/catalogue" class="rounded-xl bg-white px-5 py-3 text-sm font-semibold text-brand-700 transition hover:bg-brand-50">
          Voir notre flotte
        </a>
        <a href="/contact" class="rounded-xl border border-white/40 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
          Nous contacter
        </a>
      </div>
    </div>
  </section>

  <!-- Adresse & Contact -->
  <section class="border-t border-slate-200 bg-white py-12">
    <div class="mx-auto max-w-4xl px-4 md:px-6">
      <h2 class="font-display text-xl font-semibold text-ink-900">Où nous trouver</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3 text-sm text-slate-600">
        <div>
          <p class="font-semibold text-ink-900">Adresse</p>
          <p class="mt-1">60 rue François 1er</p>
          <p>75008 Paris, France</p>
        </div>
        <div>
          <p class="font-semibold text-ink-900">Contact</p>
          <p class="mt-1"><a href="tel:+33170955661" class="text-brand-700 hover:underline">01 70 95 56 61</a></p>
          <p><a href="mailto:contact@locpromobility.fr" class="text-brand-700 hover:underline">contact@locpromobility.fr</a></p>
        </div>
        <div>
          <p class="font-semibold text-ink-900">Informations légales</p>
          <p class="mt-1">LOCPRO — SIREN 982 806 200</p>
          <p>RCS Paris</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
