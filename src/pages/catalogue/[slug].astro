---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const items = await getCollection("vehicules");
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const { nom, categorie, description, tarifs, images, disponible, specs } = item.data;

const catLabels: Record<string, string> = {
  "velo-electrique": "Vélo électrique",
  cargo: "Cargo",
  trottinette: "Trottinette",
  gyropode: "Gyropode",
};

const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: nom,
  description,
  image: images.map((i) => new URL(i.src, Astro.site).toString()),
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "EUR",
    availability: disponible
      ? "https://schema.org/InStock"
      : "https://schema.org/OutOfStock",
    offerCount: tarifs.length,
  },
};
---

<BaseLayout
  title={`${nom} — LocPro Mobilité`}
  description={description}
  structuredData={productLd}
>
  <article class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <nav class="text-sm text-slate-500" aria-label="Fil d'Ariane">
      <a href="/catalogue" class="hover:text-brand-700">Catalogue</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800">{nom}</span>
    </nav>
    <div class="mt-6 grid gap-10 lg:grid-cols-2">
      <div>
        <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
          {images[0] ? (
            <Image
              src={images[0]}
              alt={nom}
              width={1200}
              height={900}
              loading="eager"
              class="h-full w-full object-cover"
            />
          ) : (
            <img src="/images/placeholder-bike.svg" alt={nom} width="1200" height="900" loading="eager" class="h-full w-full object-cover" />
          )}
        </div>
      </div>
      <div>
        <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-900"
          >{catLabels[categorie]}</span
        >
        <h1 class="mt-3 font-display text-3xl font-bold text-ink-900 md:text-4xl">
          {nom}
        </h1>
        <p class="mt-4 text-lg text-slate-600">{description}</p>
        {
          specs && specs.length > 0 && (
            <dl class="mt-8 grid gap-3 sm:grid-cols-2">
              {specs.map((s) => (
                <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
                  <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">
                    {s.label}
                  </dt>
                  <dd class="mt-1 font-semibold text-ink-900">{s.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        <div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-sm font-semibold text-ink-900">Tarifs indicatifs</h2>
          <ul class="mt-4 space-y-2">
            {
              tarifs.map((t) => (
                <li class="flex justify-between gap-4 text-sm">
                  <span class="text-slate-600">{t.label}</span>
                  <span class="font-semibold text-ink-900">{t.prix}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          {
            disponible ? (
              <a
                href={`/reserver?vehicule=${item.slug}`}
                class="inline-flex rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
              >
                Réserver ce modèle
              </a>
            ) : (
              <span class="inline-flex rounded-xl bg-slate-200 px-5 py-3 text-sm font-semibold text-slate-600">
                Actuellement indisponible
              </span>
            )
          }
          <a
            href="/contact"
            class="inline-flex rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-ink-800 shadow-sm transition hover:border-brand-200 hover:bg-brand-50"
          >
            Être alerté
          </a>
        </div>
      </div>
    </div>
    <div class="mt-12 max-w-3xl space-y-4 text-base leading-relaxed text-slate-700 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-ink-900 [&_a]:text-brand-700 [&_a]:underline">
      <Content />
    </div>
  </article>
</BaseLayout>
