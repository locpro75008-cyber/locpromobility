---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrustBadges from "../../components/TrustBadges.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const items = await getCollection("vehicules");
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const { nom, categorie, tagline, description, tarifs, caution, images, disponible, specs, points_forts, public_cible } = item.data;

const catLabels: Record<string, string> = {
  "velo-electrique": "Vélo électrique",
  cargo: "Cargo électrique",
  trottinette: "Trottinette électrique",
  gyropode: "Gyropode",
};

// Autres véhicules pour la section "similaires"
const allVehicules = await getCollection("vehicules");
const similaires = allVehicules
  .filter((v) => v.slug !== item.slug && v.data.categorie === categorie)
  .slice(0, 2);
const autresCategories = allVehicules
  .filter((v) => v.slug !== item.slug && v.data.categorie !== categorie)
  .slice(0, 2);
const suggestions = similaires.length > 0 ? similaires : autresCategories;

const prixDepart = tarifs[0]?.prix ?? "Sur devis";

const SITE = Astro.site?.toString().replace(/\/$/, "") || "https://locpromobility.fr";
const canonicalCat = `${SITE}/catalogue/${item.slug}`;

const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: nom,
  description,
  image: images.map((i) => `${SITE}${i.src}`),
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "EUR",
    availability: disponible
      ? "https://schema.org/InStock"
      : "https://schema.org/OutOfStock",
    offerCount: tarifs.length,
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: SITE },
    { "@type": "ListItem", position: 2, name: "Catalogue", item: `${SITE}/catalogue` },
    { "@type": "ListItem", position: 3, name: nom, item: canonicalCat },
  ],
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `Quelle est l'autonomie réelle du ${nom} ?`,
      acceptedAnswer: { "@type": "Answer", text: "En usage urbain parisien, comptez 60 à 80% de l'autonomie maximale annoncée. Nos techniciens vous précisent l'autonomie lors de la prise en main." },
    },
    {
      "@type": "Question",
      name: "La caution est-elle débitée immédiatement ?",
      acceptedAnswer: { "@type": "Answer", text: "Non. La caution est une empreinte bancaire non débitée, libérée dans les 5 jours ouvrés suivant le retour du véhicule en bon état." },
    },
    {
      "@type": "Question",
      name: "Que se passe-t-il en cas de panne ?",
      acceptedAnswer: { "@type": "Answer", text: "Notre assistance intervient sous 4h dans Paris et petite couronne. Un véhicule de remplacement est livré sous 24h si la réparation est impossible en urgence." },
    },
    {
      "@type": "Question",
      name: "Le Forfait Mobilités Durables s'applique-t-il ?",
      acceptedAnswer: { "@type": "Answer", text: "Oui. Toute location mensuelle LocPro est éligible au FMD (jusqu'à 800 €/an exonérés). Nous fournissons l'attestation nécessaire pour votre employeur." },
    },
  ],
};
---

<BaseLayout
  title={`${nom} — Location vélo électrique Paris | LocPro Mobilité`}
  description={description}
  structuredData={[productLd, breadcrumbLd, faqLd]}
>
  <article class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-14">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-500" aria-label="Fil d'Ariane">
      <a href="/" class="hover:text-brand-700">Accueil</a>
      <span>/</span>
      <a href="/catalogue" class="hover:text-brand-700">Catalogue</a>
      <span>/</span>
      <span class="text-slate-800 font-medium">{nom}</span>
    </nav>

    <!-- Contenu principal -->
    <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_380px]">

      <!-- Colonne gauche : image + description -->
      <div class="space-y-8">

        <!-- Image principale -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
          {images[0] ? (
            <Image
              src={images[0]}
              alt={nom}
              width={1200}
              height={800}
              loading="eager"
              fetchpriority="high"
              class="w-full object-cover"
            />
          ) : (
            <img src="/images/placeholder-bike.svg" alt={nom} width="1200" height="800" loading="eager" fetchpriority="high" class="w-full object-cover" />
          )}
        </div>

        <!-- Points forts -->
        {points_forts && points_forts.length > 0 && (
          <div class="rounded-2xl border border-brand-100 bg-brand-50 p-6">
            <h2 class="font-display text-lg font-semibold text-brand-900">Points forts</h2>
            <ul class="mt-4 grid gap-2 sm:grid-cols-2">
              {points_forts.map((pt) => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Spécifications techniques -->
        {specs && specs.length > 0 && (
          <div>
            <h2 class="font-display text-lg font-semibold text-ink-900">Caractéristiques techniques</h2>
            <dl class="mt-4 divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white overflow-hidden">
              {specs.map((s, i) => (
                <div class={`flex justify-between px-5 py-3 text-sm ${i % 2 === 1 ? "bg-slate-50" : ""}`}>
                  <dt class="font-medium text-slate-500">{s.label}</dt>
                  <dd class="font-semibold text-ink-900 text-right">{s.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        <!-- Description longue (contenu Markdown) -->
        <div class="prose prose-slate max-w-none prose-headings:font-display prose-headings:text-ink-900 prose-a:text-brand-700 prose-strong:text-ink-900">
          <Content />
        </div>

        <!-- Public cible -->
        {public_cible && public_cible.length > 0 && (
          <div>
            <h2 class="font-display text-lg font-semibold text-ink-900">Ce véhicule est fait pour vous si…</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {public_cible.map((p) => (
                <li class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm">
                  {p}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Colonne droite : tarifs + CTA (sticky) -->
      <aside class="space-y-5 lg:sticky lg:top-6 lg:self-start">

        <!-- Badge catégorie + dispo -->
        <div class="flex items-center gap-2 flex-wrap">
          <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-900">
            {catLabels[categorie]}
          </span>
          {disponible ? (
            <span class="flex items-center gap-1 rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-green-500"></span>
              Disponible
            </span>
          ) : (
            <span class="flex items-center gap-1 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-amber-500"></span>
              Sur réservation
            </span>
          )}
        </div>

        <!-- Nom + tagline -->
        <div>
          <h1 class="font-display text-2xl font-bold text-ink-900 md:text-3xl">{nom}</h1>
          {tagline && <p class="mt-1 text-base text-slate-500 italic">{tagline}</p>}
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">{description}</p>
        </div>

        <!-- Tarifs -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Tarifs de location</p>
          <ul class="mt-3 space-y-2">
            {tarifs.map((t) => (
              <li class="flex items-center justify-between gap-4 text-sm">
                <span class="text-slate-600">{t.label}</span>
                <span class="font-bold text-ink-900 text-base">{t.prix}</span>
              </li>
            ))}
          </ul>
          {caution && (
            <div class="mt-4 border-t border-slate-100 pt-4">
              <div class="flex items-start gap-2 text-xs text-slate-500">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>Caution : <strong class="text-slate-700">{caution}</strong> — restituée à la restitution du véhicule en bon état</span>
              </div>
            </div>
          )}
        </div>

        <!-- CTAs -->
        <div class="space-y-3">
          {disponible ? (
            <a
              href={`/reserver?vehicule=${item.slug}`}
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Réserver ce modèle
            </a>
          ) : (
            <a
              href="/contact"
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
            >
              Nous contacter pour disponibilité
            </a>
          )}
          <a
            href="/entreprises"
            class="flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-ink-800 shadow-sm transition hover:border-brand-200 hover:bg-brand-50"
          >
            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            Devis entreprise (flotte)
          </a>
        </div>

        <!-- Garanties -->
        <TrustBadges />

        <!-- Contact téléphone -->
        <div class="text-center">
          <p class="text-xs text-slate-400">Des questions ?</p>
          <a href="tel:+33170955661" class="text-sm font-semibold text-brand-700 hover:underline">
            01 70 95 56 61
          </a>
          <span class="text-xs text-slate-400"> — Lun–Sam 9h–19h</span>
        </div>
      </aside>
    </div>

    <!-- Véhicules suggérés -->
    {suggestions.length > 0 && (
      <section class="mt-16 border-t border-slate-200 pt-12">
        <h2 class="font-display text-xl font-bold text-ink-900">Vous pourriez aussi aimer</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
          {suggestions.map((v) => (
            <a
              href={`/catalogue/${v.slug}`}
              class="group flex gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-brand-200 hover:shadow-md"
            >
              {v.data.images[0] && (
                <Image
                  src={v.data.images[0]}
                  alt={v.data.nom}
                  width={120}
                  height={90}
                  loading="lazy"
                  class="h-20 w-28 shrink-0 rounded-xl object-cover"
                />
              )}
              <div class="min-w-0">
                <p class="text-xs font-medium text-brand-700">{catLabels[v.data.categorie]}</p>
                <p class="mt-0.5 font-semibold text-ink-900 group-hover:text-brand-700 truncate">{v.data.nom}</p>
                <p class="mt-1 line-clamp-2 text-xs text-slate-500">{v.data.description}</p>
                <p class="mt-2 text-xs font-bold text-ink-900">Dès {v.data.tarifs[0]?.prix}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- FAQ enrichie avec structured data FAQPage -->
    <section class="mt-16 border-t border-slate-200 pt-12" id="faq">
      <h2 class="font-display text-xl font-bold text-ink-900">Questions fréquentes</h2>
      <dl class="mt-6 space-y-4" id="faq-list">
        {[
          {
            q: `Quelle est l'autonomie réelle du ${nom} ?`,
            a: `L'autonomie annoncée est mesurée en conditions optimales. En usage urbain parisien (niveau d'assistance modéré, relief faible), comptez 60 à 80% de l'autonomie maximale. Nos techniciens vous précisent l'autonomie réelle lors de la prise en main.`,
          },
          {
            q: "La caution est-elle débitée immédiatement ?",
            a: "Non. La caution est une empreinte bancaire (pré-autorisation) : elle est réservée sur votre carte mais non débitée. Elle est libérée dans les 5 jours ouvrés suivant le retour du véhicule en bon état.",
          },
          {
            q: "Que se passe-t-il en cas de panne ?",
            a: "Appelez notre assistance au 01 70 95 56 61 (7j/7, 8h-20h). Pour les pannes techniques, nous intervenons sous 4h dans Paris et petite couronne. Si la réparation est impossible en urgence, un véhicule de remplacement est livré sous 24h.",
          },
          {
            q: "Puis-je modifier ou annuler ma réservation ?",
            a: "Pour les formules courte durée, modification possible jusqu'à 24h avant. Pour les abonnements mensuels, résiliation avec 15 jours de préavis. Aucun frais d'annulation si vous prévenez dans les délais.",
          },
          {
            q: "Le Forfait Mobilités Durables s'applique-t-il à cette location ?",
            a: "Oui. Toute location mensuelle LocPro est éligible au FMD (jusqu'à 800 €/an exonérés d'impôt et de charges). Nous vous fournissons l'attestation nécessaire pour votre employeur sur simple demande.",
          },
        ].map((item, i) => (
          <div class="rounded-2xl border border-slate-200 bg-white">
            <button
              type="button"
              class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-sm font-semibold text-ink-900 hover:text-brand-700"
              aria-expanded="false"
              data-faq-toggle
            >
              <dt>{item.q}</dt>
              <svg class="h-4 w-4 shrink-0 text-slate-400 transition-transform duration-200 faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <dd class="hidden px-5 pb-4 text-sm text-slate-600 leading-relaxed faq-answer">
              {item.a}
            </dd>
          </div>
        ))}
      </dl>
    </section>

  </article>
</BaseLayout>

<script is:inline>
(function () {
  document.querySelectorAll("[data-faq-toggle]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      const answer = btn.parentElement.querySelector(".faq-answer");
      const icon = btn.querySelector(".faq-icon");
      if (answer) answer.classList.toggle("hidden", expanded);
      if (icon) icon.style.transform = expanded ? "" : "rotate(180deg)";
    });
  });
})();
</script>
