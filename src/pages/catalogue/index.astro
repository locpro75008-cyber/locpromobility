---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";
import { autonomieKm, prixMin } from "../../lib/vehicle-utils";

const all = await getCollection("vehicules");
const ordered = all.sort((a, b) => a.data.nom.localeCompare(b.data.nom, "fr"));
---

<BaseLayout
  title="Catalogue location vélo électrique Paris — LocPro Mobilité"
  description="Louez un vélo électrique, cargo, trottinette ou gyropode à Paris. Modèles disponibles avec fiches détaillées, autonomie, specs et tarifs. Livraison possible."
>
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <nav aria-label="Fil d'Ariane" class="mb-6 text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-brand-700">Accueil</a></li>
        <li aria-hidden="true" class="mx-1">›</li>
        <li class="text-slate-800">Catalogue</li>
      </ol>
    </nav>
    <h1 class="font-display text-3xl font-bold text-ink-900 md:text-4xl">Catalogue</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Filtrez par catégorie. Comparez les modèles sur le{" "}
      <a href="/comparateur" class="font-medium text-brand-700 underline">comparateur</a> ou consultez la page{" "}
      <a href="/tarifs" class="font-medium text-brand-700 underline">Tarifs</a>.
    </p>

    <!-- Filtres avancés -->
    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-ink-900">Filtres avancés</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <div>
          <label for="filter-prix" class="text-xs font-medium text-slate-500">Prix max / jour</label>
          <select id="filter-prix" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm">
            <option value="999">Tous les prix</option>
            <option value="30">≤ 30 €</option>
            <option value="60">≤ 60 €</option>
            <option value="100">≤ 100 €</option>
          </select>
        </div>
        <div>
          <label for="filter-auto" class="text-xs font-medium text-slate-500">Autonomie min.</label>
          <select id="filter-auto" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm">
            <option value="0">Toutes</option>
            <option value="40">≥ 40 km</option>
            <option value="60">≥ 60 km</option>
            <option value="80">≥ 80 km</option>
          </select>
        </div>
        <div>
          <label for="filter-tri" class="text-xs font-medium text-slate-500">Trier par</label>
          <select id="filter-tri" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm">
            <option value="nom">Nom (A→Z)</option>
            <option value="prix-asc">Prix croissant</option>
            <option value="prix-desc">Prix décroissant</option>
            <option value="auto-desc">Autonomie décroissante</option>
          </select>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Filtrer par catégorie">
      <button
        type="button"
        class="filter-btn rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm data-[active=true]:border-brand-500 data-[active=true]:bg-brand-50 data-[active=true]:text-brand-900"
        data-filter="all"
        data-active="true"
      >
        Tout
      </button>
      <button
        type="button"
        class="filter-btn rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm data-[active=true]:border-brand-500 data-[active=true]:bg-brand-50 data-[active=true]:text-brand-900"
        data-filter="velo-electrique"
      >
        Vélo électrique
      </button>
      <button
        type="button"
        class="filter-btn rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm data-[active=true]:border-brand-500 data-[active=true]:bg-brand-50 data-[active=true]:text-brand-900"
        data-filter="cargo"
      >
        Cargo
      </button>
      <button
        type="button"
        class="filter-btn rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm data-[active=true]:border-brand-500 data-[active=true]:bg-brand-50 data-[active=true]:text-brand-900"
        data-filter="trottinette"
      >
        Trottinette
      </button>
      <button
        type="button"
        class="filter-btn rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm data-[active=true]:border-brand-500 data-[active=true]:bg-brand-50 data-[active=true]:text-brand-900"
        data-filter="gyropode"
      >
        Gyropode
      </button>
      <button
        type="button"
        class="filter-btn rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm data-[active=true]:border-brand-500 data-[active=true]:bg-brand-50 data-[active=true]:text-brand-900"
        data-filter="dispo"
      >
        Disponible seulement
      </button>
    </div>

    <div
      id="catalogue-grid"
      class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        ordered.map((v) => (
          <div
            class="vehicle-tile"
            data-categorie={v.data.categorie}
            data-dispo={v.data.disponible ? "1" : "0"}
            data-prix={prixMin(v.data.tarifs)}
            data-auto={autonomieKm(v.data.specs)}
            data-nom={v.data.nom}
          >
            <ProductCard vehicle={v} />
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const grid = document.getElementById("catalogue-grid");
  const prixSel = document.getElementById("filter-prix");
  const autoSel = document.getElementById("filter-auto");
  const triSel = document.getElementById("filter-tri");
  let catFilter = "all";

  function getTiles() {
    return [...document.querySelectorAll(".vehicle-tile")];
  }

  const apply = () => {
    buttons.forEach((b) => {
      if (b instanceof HTMLElement)
        b.dataset.active = b.getAttribute("data-filter") === catFilter ? "true" : "false";
    });

    const prixMax = parseInt(prixSel?.value || "999", 10);
    const autoMin = parseInt(autoSel?.value || "0", 10);
    const tri = triSel?.value || "nom";

    const tiles = getTiles().filter((tile) => {
      if (!(tile instanceof HTMLElement)) return false;
      const cat = tile.dataset.categorie || "";
      const dispo = tile.dataset.dispo === "1";
      const prix = parseInt(tile.dataset.prix || "999", 10);
      const auto = parseInt(tile.dataset.auto || "0", 10);
      let show = true;
      if (catFilter === "dispo") show = dispo;
      else if (catFilter !== "all") show = cat === catFilter;
      if (show && prix > prixMax) show = false;
      if (show && auto < autoMin) show = false;
      tile.style.display = show ? "" : "none";
      return show;
    });

    if (grid && tri !== "nom") {
      const sorted = [...tiles].sort((a, b) => {
        const pa = parseInt(a.dataset.prix || "0", 10);
        const pb = parseInt(b.dataset.prix || "0", 10);
        const aa = parseInt(a.dataset.auto || "0", 10);
        const ab = parseInt(b.dataset.auto || "0", 10);
        if (tri === "prix-asc") return pa - pb;
        if (tri === "prix-desc") return pb - pa;
        if (tri === "auto-desc") return ab - aa;
        return 0;
      });
      sorted.forEach((t) => grid.appendChild(t));
    }
  };

  apply();

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      catFilter = btn.getAttribute("data-filter") || "all";
      apply();
    });
  });
  prixSel?.addEventListener("change", apply);
  autoSel?.addEventListener("change", apply);
  triSel?.addEventListener("change", apply);
</script>
