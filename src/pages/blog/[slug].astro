---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const now = new Date();
  const posts = (await getCollection("blog")).filter((p) => p.data.pubDate <= now);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, description, pubDate, heroImage } = post.data;

// Table des matières — uniquement les h2 et h3
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const now2 = new Date();
const allPosts = (await getCollection("blog")).filter((p) => p.data.pubDate <= now2);

// Articles similaires : préférer ceux dont le titre partage des mots-clés
const titleWords = title.toLowerCase().split(/\s+/).filter((w) => w.length > 4);
const related = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((p) => ({
    post: p,
    score: titleWords.filter(
      (w) => p.data.title.toLowerCase().includes(w) || p.data.description.toLowerCase().includes(w)
    ).length,
  }))
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x) => x.post);

// Calcul du temps de lecture (~200 mots/min)
const wordCount = post.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const SITE_URL = Astro.site?.toString().replace(/\/$/, "") || "https://locpromobility.fr";
const pageUrl = encodeURIComponent(`${SITE_URL}/blog/${post.slug}`);
const pageTitle = encodeURIComponent(title);

const SITE = Astro.site?.toString().replace(/\/$/, "") || "https://locpromobility.fr";
const canonical = `${SITE}/blog/${post.slug}`;
const imageUrl = heroImage ? `${SITE}${heroImage.src}` : `${SITE}/og-default.svg`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  author: {
    "@type": "Organization",
    name: "LocPro Mobilité",
    url: SITE,
  },
  publisher: {
    "@type": "Organization",
    name: "LocPro Mobilité",
    logo: {
      "@type": "ImageObject",
      url: `${SITE}/favicon.svg`,
    },
  },
  image: {
    "@type": "ImageObject",
    url: imageUrl,
    width: 1200,
    height: 675,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonical,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: SITE },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog` },
    { "@type": "ListItem", position: 3, name: title, item: canonical },
  ],
};
---

<BaseLayout
  title={`${title} — LocPro Mobilité`}
  description={description}
  ogImage={heroImage?.src}
  structuredData={[articleSchema, breadcrumbSchema]}
>
  <!-- Barre de progression de lecture -->
  <div
    id="read-progress"
    class="fixed top-0 left-0 z-[100] h-1 w-0 bg-gradient-to-r from-brand-500 to-brand-700 transition-none"
    role="progressbar"
    aria-label="Progression de lecture"
  ></div>

  <article class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-brand-700">Accueil</a></li>
        <li aria-hidden="true" class="mx-1">›</li>
        <li><a href="/blog" class="hover:text-brand-700">Blog</a></li>
        <li aria-hidden="true" class="mx-1">›</li>
        <li class="text-slate-800 line-clamp-1">{title}</li>
      </ol>
    </nav>

    <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-500">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}
      </time>
      <span aria-hidden="true">·</span>
      <span class="flex items-center gap-1">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {readingTime} min de lecture
      </span>
    </div>
    <h1 class="mt-2 font-display text-3xl font-bold text-ink-900 md:text-4xl">{title}</h1>
    <p class="mt-4 text-lg text-slate-600">{description}</p>

    {
      heroImage && (
        <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200">
          <Image src={heroImage} alt={title} width={1200} height={675} loading="eager" fetchpriority="high" class="w-full" />
        </div>
      )
    }

    <!-- Table des matières (si l'article a ≥ 3 titres h2/h3) -->
    {tocHeadings.length >= 3 && (
      <nav
        id="toc"
        class="mt-8 rounded-2xl border border-brand-100 bg-brand-50/60 p-5"
        aria-label="Table des matières"
      >
        <p class="flex items-center gap-2 text-sm font-bold text-brand-800">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h10" />
          </svg>
          Table des matières
        </p>
        <ol class="mt-3 space-y-1.5 text-sm">
          {tocHeadings.map((h) => (
            <li class={h.depth === 3 ? "ml-4" : ""}>
              <a
                href={`#${h.slug}`}
                class="text-brand-700 hover:underline"
              >
                {h.depth === 3 && <span class="mr-1 text-brand-400">·</span>}
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- Contenu de l'article -->
    <div class="prose-locpro mt-10">
      <Content />
    </div>

    <!-- Partage social -->
    <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-slate-200 pt-6">
      <span class="text-sm font-semibold text-slate-600">Partager :</span>
      <a
        href={`https://twitter.com/intent/tweet?url=${pageUrl}&text=${pageTitle}`}
        target="_blank" rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50"
        aria-label="Partager sur X (Twitter)"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.856L2 2.25h6.945l4.251 5.617L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>
        X / Twitter
      </a>
      <a
        href={`https://www.linkedin.com/sharing/share-offsite/?url=${pageUrl}`}
        target="_blank" rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50"
        aria-label="Partager sur LinkedIn"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </a>
      <a
        href={`https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`}
        target="_blank" rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50"
        aria-label="Partager sur Facebook"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Facebook
      </a>
      <button
        id="copy-link-btn"
        class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50"
        aria-label="Copier le lien"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span id="copy-link-text">Copier le lien</span>
      </button>
    </div>

    <!-- CTA fin d'article -->
    <div class="mt-12 rounded-2xl bg-brand-50 border border-brand-100 p-6 text-center">
      <p class="font-semibold text-ink-900">Prêt à passer au vélo électrique ?</p>
      <p class="mt-1 text-sm text-slate-600">Découvrez nos formules de location courte, moyenne et longue durée à Paris.</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href="/catalogue" class="rounded-full bg-brand-600 px-5 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition">Voir le catalogue</a>
        <a href="/reserver" class="rounded-full border border-brand-600 px-5 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50 transition">Réserver</a>
      </div>
    </div>
  </article>

  <!-- Articles connexes -->
  {related.length > 0 && (
    <section class="border-t border-slate-200 bg-slate-50 py-12">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <h2 class="font-display text-xl font-semibold text-ink-900">Articles connexes</h2>
        <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <li>
              <a
                href={`/blog/${p.slug}`}
                class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-brand-200 hover:shadow-md"
              >
                {p.data.heroImage && (
                  <div class="aspect-[16/9] overflow-hidden bg-slate-100">
                    <Image
                      src={p.data.heroImage}
                      alt={p.data.title}
                      width={600}
                      height={337}
                      loading="lazy"
                      class="h-full w-full object-cover transition group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-5">
                  <time datetime={p.data.pubDate.toISOString()} class="text-xs text-slate-400">
                    {p.data.pubDate.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}
                  </time>
                  <h3 class="mt-1 font-semibold text-ink-900 group-hover:text-brand-700 text-sm leading-snug">{p.data.title}</h3>
                  <span class="mt-3 text-xs font-semibold text-brand-700">Lire →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<script is:inline>
(function () {
  // Barre de progression de lecture
  const bar = document.getElementById("read-progress");
  const article = document.querySelector("article");
  if (bar && article) {
    function updateProgress() {
      const articleTop = article.offsetTop;
      const articleHeight = article.offsetHeight;
      const scrolled = window.scrollY - articleTop;
      const pct = Math.min(100, Math.max(0, (scrolled / articleHeight) * 100));
      bar.style.width = pct + "%";
    }
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
  }

  // Copier le lien
  const btn = document.getElementById("copy-link-btn");
  const label = document.getElementById("copy-link-text");
  if (!btn || !label) return;
  btn.addEventListener("click", async function () {
    try {
      await navigator.clipboard.writeText(window.location.href);
      label.textContent = "Lien copié !";
      btn.classList.add("border-green-300", "text-green-700");
      setTimeout(function () {
        label.textContent = "Copier le lien";
        btn.classList.remove("border-green-300", "text-green-700");
      }, 2000);
    } catch (_) {}
  });
})();
</script>
