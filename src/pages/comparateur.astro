---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { autonomieKm, catLabels, prixMin } from "../lib/vehicle-utils";

const vehicules = (await getCollection("vehicules")).sort((a, b) =>
  a.data.nom.localeCompare(b.data.nom, "fr")
);

const compareLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Comparateur de véhicules électriques — LocPro Mobilité",
  description: "Comparez vélos électriques, cargos, trottinettes et gyropodes : autonomie, prix, specs.",
  url: "https://locpromobility.fr/comparateur",
};
---

<BaseLayout
  title="Comparateur véhicules électriques — LocPro Mobilité"
  description="Comparez jusqu'à 3 véhicules électriques côte à côte : autonomie, prix, catégorie et disponibilité. Choisissez le modèle adapté à vos besoins."
  structuredData={compareLd}
>
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "Comparateur" }]} />

    <h1 class="font-display text-3xl font-bold text-ink-900 md:text-4xl">Comparateur de véhicules</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Sélectionnez jusqu'à <strong>3 modèles</strong> pour comparer autonomie, tarifs et caractéristiques.
    </p>

    <!-- Sélection -->
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {vehicules.map((v) => (
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-brand-300 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
          <input
            type="checkbox"
            class="compare-check mt-1 h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
            value={v.slug}
            data-nom={v.data.nom}
            data-cat={catLabels[v.data.categorie] ?? v.data.categorie}
            data-prix={prixMin(v.data.tarifs)}
            data-prix-label={v.data.tarifs[0]?.prix ?? "—"}
            data-auto={autonomieKm(v.data.specs)}
            data-dispo={v.data.disponible ? "Disponible" : "Indisponible"}
            data-href={`/catalogue/${v.slug}`}
            data-img={v.data.imageUrl}
          />
          <div class="min-w-0">
            <p class="font-semibold text-sm text-ink-900">{v.data.nom}</p>
            <p class="text-xs text-slate-500">{catLabels[v.data.categorie]} · dès {v.data.tarifs[0]?.prix}</p>
          </div>
        </label>
      ))}
    </div>

    <p id="compare-limit" class="mt-3 hidden text-sm font-medium text-amber-700">
      Maximum 3 véhicules — décochez-en un pour en ajouter un autre.
    </p>

    <!-- Tableau comparatif -->
    <div id="compare-table-wrap" class="mt-10 hidden overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full min-w-[600px] text-sm">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50">
            <th class="px-4 py-3 text-left font-semibold text-slate-500">Critère</th>
            <th id="col-h1" class="px-4 py-3 text-left font-semibold text-ink-900"></th>
            <th id="col-h2" class="px-4 py-3 text-left font-semibold text-ink-900"></th>
            <th id="col-h3" class="px-4 py-3 text-left font-semibold text-ink-900"></th>
          </tr>
        </thead>
        <tbody id="compare-body" class="divide-y divide-slate-100"></tbody>
      </table>
    </div>

    <div id="compare-empty" class="mt-10 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-slate-500">
      Cochez au moins 2 véhicules pour lancer la comparaison.
    </div>

    <div class="mt-10 text-center">
      <a href="/catalogue" class="text-sm font-semibold text-brand-700 hover:underline">Voir tout le catalogue →</a>
    </div>
  </div>
</BaseLayout>

<script is:inline>
(function () {
  const checks = document.querySelectorAll(".compare-check");
  const wrap = document.getElementById("compare-table-wrap");
  const empty = document.getElementById("compare-empty");
  const limit = document.getElementById("compare-limit");
  const body = document.getElementById("compare-body");
  const cols = ["col-h1", "col-h2", "col-h3"].map((id) => document.getElementById(id));

  const rows = [
    { label: "Catégorie", key: "cat" },
    { label: "Prix dès", key: "prixLabel" },
    { label: "Autonomie max.", key: "auto", fmt: (v) => v ? v + " km" : "—" },
    { label: "Disponibilité", key: "dispo" },
  ];

  function update() {
    const selected = [...checks].filter((c) => c.checked);
    if (selected.length > 3) {
      selected[selected.length - 1].checked = false;
      if (limit) limit.classList.remove("hidden");
      return;
    }
    if (limit) limit.classList.toggle("hidden", selected.length < 3);

    if (selected.length < 2) {
      wrap?.classList.add("hidden");
      empty?.classList.remove("hidden");
      return;
    }

    wrap?.classList.remove("hidden");
    empty?.classList.add("hidden");

    cols.forEach((col, i) => {
      if (!col) return;
      const c = selected[i];
      col.textContent = c ? c.dataset.nom || "" : "";
      col.style.display = c ? "" : "none";
    });

    if (!body) return;
    body.innerHTML = rows
      .map((row) => {
        const cells = [0, 1, 2]
          .map((i) => {
            const c = selected[i];
            if (!c) return '<td class="px-4 py-3 hidden"></td>';
            let val = c.dataset[row.key === "prixLabel" ? "prixLabel" : row.key] || "—";
            if (row.fmt) val = row.fmt(val);
            return '<td class="px-4 py-3">' + val + "</td>";
          })
          .join("");
        return '<tr><td class="px-4 py-3 font-medium text-slate-500">' + row.label + "</td>" + cells + "</tr>";
      })
      .join("");

    // Ligne CTA
    const ctas = [0, 1, 2]
      .map((i) => {
        const c = selected[i];
        if (!c) return '<td class="px-4 py-3 hidden"></td>';
        return '<td class="px-4 py-3"><a href="' + c.dataset.href + '" class="text-brand-700 font-semibold hover:underline">Voir la fiche →</a></td>';
      })
      .join("");
    body.innerHTML += '<tr class="bg-brand-50"><td class="px-4 py-3 font-medium text-slate-500">Action</td>' + ctas + "</tr>";
  }

  checks.forEach((c) => c.addEventListener("change", update));
})();
</script>
