---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout
  title="Contact — LocPro Mobilité"
  description="Écrivez-nous : type de véhicule, durée, message. Réponse sous 24 h ouvrées."
  hideNewsletter={true}
>
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
    <nav aria-label="Fil d'Ariane" class="mb-6 text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-brand-700">Accueil</a></li>
        <li aria-hidden="true" class="mx-1">›</li>
        <li class="text-slate-800">Contact</li>
      </ol>
    </nav>
    <h1 class="font-display text-3xl font-bold text-ink-900">Contact</h1>
    <p class="mt-3 text-slate-600">
      Agence : 60 rue François 1er, 75008 Paris — <a
        href="tel:+33170955661"
        class="font-medium text-brand-700 hover:underline">01 70 95 56 61</a
      >
    </p>
    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <ContactForm id="contact-page" />
    </div>
  </div>
</BaseLayout>
