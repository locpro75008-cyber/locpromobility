---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCollection } from "astro:content";

const vehicules = (await getCollection("vehicules"))
  .filter((v) => v.data.disponible)
  .slice(0, 3);
---

<BaseLayout
  title="Location vélo électrique Paris — LocPro Mobilité"
  description="Location vélo électrique à Paris dès 29 €/jour. Cargo, trottinette, gyropode. Livraison à domicile. Formules courte, moyenne et longue durée. B2C et B2B."
>
  <section
    class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white"
  >
    <div
      class="pointer-events-none absolute -right-24 top-0 h-72 w-72 rounded-full bg-brand-200/40 blur-3xl"
    >
    </div>
    <div class="mx-auto max-w-6xl px-4 py-16 md:flex md:items-center md:gap-12 md:px-6 md:py-24">
      <div class="max-w-xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-800">
          Mobilité électrique
        </p>
        <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ink-900 md:text-5xl">
          Louez le bon véhicule, pour la bonne durée.
        </h1>
        <p class="mt-4 text-lg text-slate-600">
          Vélos électriques, cargos, trottinettes et gyropodes — particuliers,
          entreprises et collectivités. Parcours simple : catalogue, tarifs,
          réservation ou devis flotte.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/reserver"
            class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
          >
            Je réserve (B2C)
          </a>
          <a
            href="/entreprises"
            class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-ink-800 shadow-sm transition hover:border-brand-200 hover:bg-brand-50"
          >
            Espace entreprises
          </a>
        </div>
      </div>
      <div class="mt-12 hidden flex-1 md:block">
        <div
          class="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/60"
        >
          <p class="text-sm font-semibold text-ink-900">Grille indicative</p>
          <ul class="mt-4 space-y-3 text-sm text-slate-600">
            <li class="flex justify-between gap-4">
              <span>Court terme</span><span class="font-medium text-ink-800">à partir de 19 € / jour</span>
            </li>
            <li class="flex justify-between gap-4">
              <span>Moyen terme</span><span class="font-medium text-ink-800">dès 79 € / mois</span>
            </li>
            <li class="flex justify-between gap-4">
              <span>Long terme B2B</span><span class="font-medium text-brand-700">sur devis</span>
            </li>
          </ul>
          <a href="/tarifs" class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline"
            >Voir tous les tarifs →</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="font-display text-2xl font-bold text-ink-900 md:text-3xl">
          Véhicules disponibles
        </h2>
        <p class="mt-2 max-w-2xl text-slate-600">
          Un extrait du catalogue. Filtrez par type et durée sur la page catalogue.
        </p>
      </div>
      <a
        href="/catalogue"
        class="text-sm font-semibold text-brand-700 hover:underline">Catalogue complet →</a
      >
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {vehicules.map((v) => <ProductCard vehicle={v} />)}
    </div>
  </section>

  <!-- Compteurs animés -->
  <section class="border-y border-slate-200 bg-white py-14">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4 text-center">
        <div data-counter="500" data-suffix="+" class="counter-block">
          <p class="counter-value font-display text-4xl font-bold text-brand-700 md:text-5xl">0</p>
          <p class="mt-1 text-sm font-medium text-slate-500">Clients actifs</p>
        </div>
        <div data-counter="4.9" data-suffix="/5" class="counter-block">
          <p class="counter-value font-display text-4xl font-bold text-brand-700 md:text-5xl">0</p>
          <p class="mt-1 text-sm font-medium text-slate-500">Note Google</p>
        </div>
        <div data-counter="48" data-suffix="h" class="counter-block">
          <p class="counter-value font-display text-4xl font-bold text-brand-700 md:text-5xl">0</p>
          <p class="mt-1 text-sm font-medium text-slate-500">Délai de livraison max</p>
        </div>
        <div data-counter="330" data-suffix=" km" class="counter-block">
          <p class="counter-value font-display text-4xl font-bold text-brand-700 md:text-5xl">0</p>
          <p class="mt-1 text-sm font-medium text-slate-500">Pistes cyclables Paris</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Logos partenaires / marques -->
  <section class="bg-slate-50 py-12">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-slate-400">Véhicules équipés des meilleures marques</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-8 md:gap-12">
        {[
          { name: "Bosch", desc: "Motorisation" },
          { name: "Shimano", desc: "Transmission" },
          { name: "Yamaha", desc: "Assistance" },
          { name: "Schwalbe", desc: "Pneumatiques" },
          { name: "Magura", desc: "Freinage" },
          { name: "Brose", desc: "Moteur mid-drive" },
        ].map((brand) => (
          <div class="flex flex-col items-center gap-1 opacity-60 hover:opacity-100 transition">
            <div class="flex h-12 w-28 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 shadow-sm">
              <span class="font-display text-sm font-bold text-ink-800 tracking-tight">{brand.name}</span>
            </div>
            <span class="text-xs text-slate-400">{brand.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comment ça marche (teaser) -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <h2 class="font-display text-2xl font-bold text-ink-900 md:text-3xl">Louer un vélo, c'est simple</h2>
        <ol class="mt-6 space-y-4">
          {[
            { n: "1", t: "Choisissez votre véhicule", d: "Catalogue complet avec specs, autonomie et tarifs détaillés." },
            { n: "2", t: "Réservez en ligne", d: "Formulaire avec choix de dates et adresse de livraison. Réponse sous 2h." },
            { n: "3", t: "Livraison à votre porte", d: "Votre vélo arrive chargé et prêt à rouler sous 48h." },
            { n: "4", t: "On gère l'entretien", d: "Maintenance, assistance et remplacement inclus pendant toute la durée." },
          ].map((s) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">{s.n}</span>
              <div>
                <p class="font-semibold text-ink-900">{s.t}</p>
                <p class="mt-0.5 text-sm text-slate-600">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <a href="/comment-ca-marche" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:underline">
          Voir le guide complet →
        </a>
      </div>
      <div class="rounded-2xl bg-brand-600 p-8 text-white">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-200">Nouveau client ?</p>
        <h3 class="mt-2 font-display text-2xl font-bold">Essayez sans risque</h3>
        <ul class="mt-4 space-y-2 text-sm text-brand-100">
          <li class="flex items-center gap-2"><span class="text-brand-300">✓</span> Location à la journée dès 29 €</li>
          <li class="flex items-center gap-2"><span class="text-brand-300">✓</span> Résiliation mensuelle flexible</li>
          <li class="flex items-center gap-2"><span class="text-brand-300">✓</span> Aucun frais de mise en service</li>
          <li class="flex items-center gap-2"><span class="text-brand-300">✓</span> Assistance 7j/7 incluse</li>
        </ul>
        <a href="/reserver" class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-white px-5 py-3 text-sm font-semibold text-brand-700 transition hover:bg-brand-50">
          Réserver maintenant →
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <h2 class="font-display text-2xl font-bold text-ink-900">FAQ rapide</h2>
    <dl class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <dt class="font-semibold text-ink-900">Caution ?</dt>
        <dd class="mt-2 text-sm text-slate-600">
          Une empreinte bancaire ou caution peut être demandée selon le véhicule
          et la durée. Détail à la réservation.
        </dd>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <dt class="font-semibold text-ink-900">Assurance ?</dt>
        <dd class="mt-2 text-sm text-slate-600">
          Options RC et vol disponibles. Flottes B2B : contrat cadre et facturation
          centralisée.
        </dd>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 md:col-span-2">
        <dt class="font-semibold text-ink-900">Livraison / retrait ?</dt>
        <dd class="mt-2 text-sm text-slate-600">
          Retrait en agence ou livraison sur zone (selon disponibilité). Indiquez
          votre code postal dans le formulaire de contact.
        </dd>
      </div>
    </dl>
    <p class="mt-8 text-center">
      <a href="/faq" class="text-sm font-semibold text-brand-700 hover:underline">Voir toute la FAQ →</a>
    </p>
  </section>
  <script is:inline>
    (function () {
      function animateCounter(el) {
        const target = parseFloat(el.dataset.counter);
        const suffix = el.dataset.suffix || "";
        const isFloat = target % 1 !== 0;
        const duration = 1800;
        const step = 16;
        const steps = duration / step;
        const increment = target / steps;
        let current = 0;
        const display = el.querySelector(".counter-value");
        if (!display) return;
        const timer = setInterval(() => {
          current += increment;
          if (current >= target) {
            current = target;
            clearInterval(timer);
          }
          display.textContent = (isFloat ? current.toFixed(1) : Math.floor(current)) + suffix;
        }, step);
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter(entry.target);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      document.querySelectorAll(".counter-block").forEach((el) => observer.observe(el));
    })();
  </script>
</BaseLayout>
