---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqs = [
  {
    q: "Quels documents fournir ?",
    a: "Pièce d’identité, justificatif de domicile récent, moyen de paiement. Les entreprises joignent Kbis et demande sur papier en-tête.",
  },
  {
    q: "Puis-je changer de véhicule en cours de location ?",
    a: "Oui selon disponibilité et ajustement tarifaire. Contactez l’agence avant retour.",
  },
  {
    q: "Que couvre l’assurance optionnelle ?",
    a: "RC, vol et casco selon formules. Détail dans le contrat de location signé.",
  },
  {
    q: "Livrez-vous hors Paris ?",
    a: "Zones périphériques sur devis (volume, durée, créneaux).",
  },
  {
    q: "Annulation ?",
    a: "Conditions selon délai avant départ — voir CGU et confirmation de réservation.",
  },
];
---

<BaseLayout
  title="FAQ — LocPro Mobilité"
  description="Questions fréquentes sur la location de vélos électriques, cargos, trottinettes et gyropodes."
>
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
    <h1 class="font-display text-3xl font-bold text-ink-900">FAQ</h1>
    <p class="mt-3 text-slate-600">
      Pas trouvé votre réponse ? <a href="/contact" class="font-medium text-brand-700 underline">Contactez-nous</a>.
    </p>
    <dl class="mt-10 space-y-6">
      {
        faqs.map((item) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <dt class="font-semibold text-ink-900">{item.q}</dt>
            <dd class="mt-2 text-sm text-slate-600">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</BaseLayout>
