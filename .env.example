# URL canonique du site (sitemap, Open Graph, JSON-LD)
PUBLIC_SITE_URL=https://locpromobility.fr

# Clé API Resend — obtenez-la gratuitement sur https://resend.com
# 1. Créez un compte sur resend.com (gratuit jusqu'à 3 000 e-mails/mois)
# 2. Allez dans "API Keys" > "Create API Key"
# 3. Collez la clé ci-dessous
# 4. Ajoutez et vérifiez votre domaine locpromobility.fr dans "Domains"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Clé API Brevo (ex-Sendinblue) — newsletter automatique
# 1. Créez un compte gratuit sur https://brevo.com (300 emails/jour gratuits)
# 2. Paramètres → Clés API → Créer une clé
# 3. Créez une liste de contacts (Contacts → Listes) et notez son ID
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
BREVO_LIST_ID=2
